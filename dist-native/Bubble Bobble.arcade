    { x: 690, y: 425, w: 180 },
    { x: 240, y: 330, w: 180 },
    { x: 540, y: 330, w: 180 },
    { x: 90, y: 235, w: 180 },
    { x: 390, y: 235, w: 180 },
    { x: 690, y: 235, w: 180 },
