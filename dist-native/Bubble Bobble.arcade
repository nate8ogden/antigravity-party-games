    { x: 290, y: 135, w: 380 }
  ],
  // Cave 7: Central Chimney Drop Funnel
  [
    { x: 80, y: 420, w: 310 },
    { x: 570, y: 420, w: 310 },
    { x: 130, y: 325, w: 260 },
    { x: 570, y: 325, w: 260 },
    { x: 180, y: 230, w: 210 },
