  ],
  // Cave 10: Hourglass Chamber
  [
    { x: 110, y: 425, w: 740 },
    { x: 220, y: 330, w: 520 },
    { x: 330, y: 235, w: 300 },
    { x: 150, y: 145, w: 270 },
    { x: 540, y: 145, w: 270 }
  ],
  // Cave 11: Castle Ramparts
  [
    { x: 80, y: 425, w: 220 },
    { x: 370, y: 425, w: 220 },
    { x: 660, y: 425, w: 220 },
    { x: 160, y: 330, w: 640 },
    { x: 80, y: 235, w: 200 },
    { x: 380, y: 235, w: 200 },
    { x: 680, y: 235, w: 200 },
    { x: 140, y: 145, w: 160 },
    { x: 400, y: 145, w: 160 },
    { x: 660, y: 145, w: 160 }
  ],
  // Cave 12: Super Drunk Boss Sanctum
  [
    { x: 80, y: 425, w: 210 },
    { x: 670, y: 425, w: 210 },
    { x: 310, y: 350, w: 340 },
    { x: 80, y: 265, w: 210 },
    { x: 670, y: 265, w: 210 },
    { x: 260, y: 185, w: 440 },
