    { x: 660, y: 420, w: 200 },
    { x: 200, y: 315, w: 220 },
    { x: 540, y: 315, w: 220 },
    { x: 310, y: 205, w: 340 }
  ],
  // Cave 3: Twin Towers & central bridge
  [
    { x: 90, y: 415, w: 190 },
