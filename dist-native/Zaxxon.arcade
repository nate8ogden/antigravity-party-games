    0x00, 0x61, 0x73, 0x6d, // "\0asm"
    0x01, 0x00, 0x00, 0x00, // version 1
    ...typeSection,
    ...funcSection,
    ...memSection,
    ...exportSection,
    ...codeSection
  ]);
}
class WasmCore {
  constructor() {
    this.isWasmSupported = false;
    this.exports = null;
    this.f32View = null;
    this.i32View = null;

    // Telemetry counters
    this.stats = {
      particlesStepped: 0,
      lodePathQueries: 0,
      bezierEvaluations: 0,
      voxelsEroded: 0
    };

    this._init();
  }

  _init() {
    try {
      if (typeof WebAssembly !== 'undefined') {
        const bytes = buildArcadeWasmBinary();
        const mod = new WebAssembly.Module(bytes);
        const inst = new WebAssembly.Instance(mod);
        this.exports = inst.exports;
        if (this.exports && this.exports.memory) {
          this.f32View = new Float32Array(this.exports.memory.buffer);
          this.i32View = new Int32Array(this.exports.memory.buffer);
          this.isWasmSupported = true;
        }
      }
    } catch (_) {
      this.isWasmSupported = false;
    }

    if (typeof window !== 'undefined') {
      window.__WASM_CORE__ = this;
    }
  }

  isActive() {
    return this.isWasmSupported && this.exports !== null;
  }

  /**
   * Native WASM squared Euclidean distance
   */
  distSq(x1, y1, x2, y2) {
    if (this.exports) {
      return this.exports.distSq(x1, y1, x2, y2);
    }
    const dx = x2 - x1;
    const dy = y2 - y1;
    return dx * dx + dy * dy;
  }

  /**
   * Native WASM 2D Cubic Bezier evaluation (used by Vector2.cubicBezier & Galaga flight paths)
   */
  cubicBezier(p0, p1, p2, p3, t, outVec) {
    this.stats.bezierEvaluations++;
    if (this.exports) {
      const x = this.exports.cubicBezierAxis(p0.x, p1.x, p2.x, p3.x, t);
      const y = this.exports.cubicBezierAxis(p0.y, p1.y, p2.y, p3.y, t);
      if (outVec) {
        outVec.x = x;
        outVec.y = y;
        return outVec;
      }
      return { x, y };
    }
    const u = 1 - t;
    const tt = t * t;
    const uu = u * u;
    const uuu = uu * u;
    const ttt = tt * t;
    const x = uuu * p0.x + 3 * uu * t * p1.x + 3 * u * tt * p2.x + ttt * p3.x;
    const y = uuu * p0.y + 3 * uu * t * p1.y + 3 * u * tt * p2.y + ttt * p3.y;
    if (outVec) {
      outVec.x = x;
      outVec.y = y;
      return outVec;
    }
    return { x, y };
  }

  /**
   * Native WASM Lode Runner A* Heuristic & Linear-Memory Cost Table Pathfinder
   * Uses byte offset 65536 (Page 1) in shared WASM linear memory for zero-allocation gScore/cameFrom tables.
   */
  lodeHeuristic(c1, r1, c2, r2, verticalWeight = 12) {
    if (this.exports) {
      return this.exports.lodeHeuristic(c1 | 0, r1 | 0, c2 | 0, r2 | 0, verticalWeight | 0);
    }
    return Math.abs(c2 - c1) * 10 + Math.abs(r2 - r1) * verticalWeight;
  }

  /**
   * Lode Runner 28x16 A* Guard Pathfinding accelerated via WASM linear memory tables & heuristic
   */
  solveLodeRunnerAStar(cols, rows, startCol, startRow, goalCol, goalRow, getNeighborsFn) {
    this.stats.lodePathQueries++;
    const totalCells = cols * rows;
    const startIdx = startRow * cols + startCol;
    const goalIdx = goalRow * cols + goalCol;
    if (startIdx === goalIdx) return null;

    // Use WASM linear memory Page 1 (byte offset 65536 -> i32 index 16384) for gScore, fScore, cameFrom, closed
    const baseI32 = 16384;
    const gScoreOffset = baseI32;
    const fScoreOffset = baseI32 + totalCells;
    const cameFromOffset = baseI32 + totalCells * 2;
    const closedOffset = baseI32 + totalCells * 3;
    const mem = this.i32View;

    if (mem && this.exports) {
      for (let i = 0; i < totalCells; i++) {
        mem[gScoreOffset + i] = 999999;
        mem[fScoreOffset + i] = 999999;
        mem[cameFromOffset + i] = -1;
        mem[closedOffset + i] = 0;
      }

      mem[gScoreOffset + startIdx] = 0;
      mem[fScoreOffset + startIdx] = this.exports.lodeHeuristic(startCol, startRow, goalCol, goalRow, 12);

      const open = [startIdx];
      let bestIdx = startIdx;
      let bestH = mem[fScoreOffset + startIdx];
      let steps = 0;

      while (open.length > 0 && steps < 280) {
        steps++;
        let lowestPos = 0;
        let lowestF = mem[fScoreOffset + open[0]];
        for (let i = 1; i < open.length; i++) {
          const f = mem[fScoreOffset + open[i]];
          if (f < lowestF) {
            lowestF = f;
            lowestPos = i;
          }
        }

        const current = open[lowestPos];
        open.splice(lowestPos, 1);

        if (current === goalIdx) {
          bestIdx = current;
          break;
        }

        mem[closedOffset + current] = 1;
        const cc = current % cols;
        const cr = (current / cols) | 0;

        const neighbors = getNeighborsFn(cc, cr);
        for (let i = 0; i < neighbors.length; i++) {
          const nb = neighbors[i];
          const nIdx = nb.row * cols + nb.col;
          if (mem[closedOffset + nIdx] === 1) continue;

          const tentativeG = mem[gScoreOffset + current] + ((nb.cost || 1) * 10);
          if (tentativeG < mem[gScoreOffset + nIdx]) {
            mem[cameFromOffset + nIdx] = current;
            mem[gScoreOffset + nIdx] = tentativeG;
            const h = this.exports.lodeHeuristic(nb.col, nb.row, goalCol, goalRow, 12);
            mem[fScoreOffset + nIdx] = tentativeG + h;
            if (h < bestH) {
              bestH = h;
              bestIdx = nIdx;
            }
            if (!open.includes(nIdx)) {
              open.push(nIdx);
            }
          }
        }
      }

      let cur = bestIdx;
      if (cur === startIdx) return null;
      while (mem[cameFromOffset + cur] !== -1 && mem[cameFromOffset + cur] !== startIdx) {
        cur = mem[cameFromOffset + cur];
      }
      return { col: cur % cols, row: (cur / cols) | 0 };
    }

    return null;
  }

  /**
   * Batch integrates particle arrays in-place using WASM linear memory (`stepParticleBatch`)
   */
  stepParticles(particles, dt, gravity = 0, drag = 0.98) {
    const len = particles ? particles.length : 0;
    if (len === 0) return;

    const maxBatch = 2000;
    if (this.exports && this.f32View && len <= maxBatch) {
      const view = this.f32View;
      for (let i = 0; i < len; i++) {
        const p = particles[i];
        const base = i * 6;
        view[base] = p.x;
        view[base + 1] = p.y;
        view[base + 2] = p.vx || 0;
        view[base + 3] = p.vy || 0;
        view[base + 4] = p.life !== undefined ? p.life : (p.timer !== undefined ? p.timer : 0.5);
        view[base + 5] = p.maxLife || 1.0;
      }

      this.exports.stepParticleBatch(0, len, dt, gravity, drag);
      this.stats.particlesStepped += len;

      let alive = 0;
      for (let i = 0; i < len; i++) {
        const base = i * 6;
        const life = view[base + 4];
        if (life > 0) {
          const p = particles[i];
          p.x = view[base];
          p.y = view[base + 1];
          p.vx = view[base + 2];
          p.vy = view[base + 3];
          if (p.life !== undefined) p.life = life;
          if (p.timer !== undefined) p.timer = life;
          particles[alive++] = p;
        }
      }
      particles.length = alive;
      return;
    }

    // JS fallback
    let alive = 0;
    for (let i = 0; i < len; i++) {
      const p = particles[i];
      p.vx = (p.vx || 0) * drag;
      p.vy = ((p.vy || 0) + gravity * dt) * drag;
      p.x += p.vx * dt;
      p.y += p.vy * dt;
      if (p.life !== undefined) {
        p.life -= dt;
        if (p.life > 0) particles[alive++] = p;
      } else if (p.timer !== undefined) {
        p.timer -= dt;
        if (p.timer > 0) particles[alive++] = p;
      }
    }
    particles.length = alive;
  }

  /**
   * Erodes a 2D voxel/soil matrix (Space Invaders bunkers / Dig Dug soil) using WASM linear memory
   */
  erodeVoxelMatrix(matrix, cx, cy, radius) {
    const rows = matrix.length;
    const cols = rows > 0 ? matrix[0].length : 0;
    if (rows === 0 || cols === 0) return 0;
    const radSq = Math.round(radius * radius);

    // Use byte offset 81920 (i32 index 20480) in WASM memory
    const baseByte = 81920;
    const baseI32 = baseByte >> 2;
    if (this.exports && this.i32View && rows * cols <= 8192) {
      const view = this.i32View;
      for (let r = 0; r < rows; r++) {
        const rowArr = matrix[r];
        const rowBase = baseI32 + r * cols;
        for (let c = 0; c < cols; c++) {
          view[rowBase + c] = rowArr[c] ? 1 : 0;
        }
      }
      const eroded = this.exports.erodeGridCircle(
        baseByte,
        cols,
        rows,
        Math.round(cx),
        Math.round(cy),
        radSq
      );
      if (eroded > 0) {
        for (let r = 0; r < rows; r++) {
          const rowArr = matrix[r];
          const rowBase = baseI32 + r * cols;
          for (let c = 0; c < cols; c++) {
            rowArr[c] = view[rowBase + c];
          }
        }
        this.stats.voxelsEroded += eroded;
      }
      return eroded;
    }

    // JS fallback
    let eroded = 0;
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        const dx = c - cx;
        const dy = r - cy;
        if (dx * dx + dy * dy <= radSq && matrix[r][c]) {
          matrix[r][c] = 0;
          eroded++;
        }
      }
    }
    return eroded;
  }

  /**
   * Benchmarks WASM vs JS performance for Lode Runner heuristics & batch particle integration
   */
  runBenchmark(particleCount = 1000, iterations = 150) {
    const nowFn = typeof performance !== 'undefined' ? () => performance.now() : () => Date.now();

    let wasmTimeMs = 0;
    if (this.exports && this.f32View) {
      for (let i = 0; i < particleCount * 6; i += 6) {
        this.f32View[i] = 100;
        this.f32View[i + 1] = 100;
        this.f32View[i + 2] = 25;
        this.f32View[i + 3] = -40;
        this.f32View[i + 4] = 5.0;
        this.f32View[i + 5] = 5.0;
      }
      const t0 = nowFn();
      for (let step = 0; step < iterations; step++) {
        this.exports.stepParticleBatch(0, particleCount, 0.016, 480.0, 0.98);
        this.exports.lodeHeuristic(2, 3, 25, 14, 12);
      }
      wasmTimeMs = Math.max(0.01, nowFn() - t0);
    }

    const jsBuf = new Float32Array(particleCount * 6);
    const t1 = nowFn();
    let dummy = 0;
    for (let step = 0; step < iterations; step++) {
      for (let i = 0; i < particleCount * 6; i += 6) {
        jsBuf[i + 2] *= 0.98;
        jsBuf[i + 3] = (jsBuf[i + 3] + 480.0 * 0.016) * 0.98;
        jsBuf[i] += jsBuf[i + 2] * 0.016;
        jsBuf[i + 1] += jsBuf[i + 3] * 0.016;
        jsBuf[i + 4] -= 0.016;
      }
      dummy += Math.abs(25 - 2) * 10 + Math.abs(14 - 3) * 12;
    }
    const jsTimeMs = Math.max(0.01, nowFn() - t1);

    return {
      wasmActive: this.isActive(),
      wasmTimeMs: Number(wasmTimeMs.toFixed(3)),
      jsTimeMs: Number(jsTimeMs.toFixed(3)),
      speedupFactor: Number((jsTimeMs / Math.max(0.005, wasmTimeMs)).toFixed(2)),
      dummy
    };
  }
}
const wasmCore = new WasmCore();



// === src/engine/Vector2.js ===
/**
 * Vector2.js
 * Zero-dependency 2D vector mathematics library for Retro Arcade Studio physics,
 * steering, momentum, and trajectory calculations.
 */
class Vector2 {
  constructor(x = 0, y = 0) {
    this.x = x;
    this.y = y;
  }

  set(x, y) {
    this.x = x;
    this.y = y;
    return this;
  }

  copy(v) {
    this.x = v.x;
    this.y = v.y;
    return this;
  }

  clone() {
    return new Vector2(this.x, this.y);
  }

  add(v) {
    this.x += v.x;
    this.y += v.y;
    return this;
  }

  addScaled(v, scale) {
    this.x += v.x * scale;
    this.y += v.y * scale;
    return this;
  }

  sub(v) {
    this.x -= v.x;
    this.y -= v.y;
    return this;
  }

  scale(scalar) {
    this.x *= scalar;
    this.y *= scalar;
    return this;
  }

  dot(v) {
    return this.x * v.x + this.y * v.y;
  }

  cross(v) {
    return this.x * v.y - this.y * v.x;
  }

  lenSq() {
    return this.x * this.x + this.y * this.y;
  }

  len() {
    return Math.hypot(this.x, this.y);
  }

  normalize() {
    const l = this.len();
    if (l > 1e-7) {
      this.x /= l;
      this.y /= l;
    } else {
      this.x = 0;
      this.y = 0;
    }
    return this;
  }

  limit(max) {
    const lSq = this.lenSq();
    if (lSq > max * max) {
      this.normalize().scale(max);
    }
    return this;
  }

  distSq(v) {
    return wasmCore.distSq(this.x, this.y, v.x, v.y);
  }

  dist(v) {
    return Math.sqrt(wasmCore.distSq(this.x, this.y, v.x, v.y));
  }

  angle() {
    return Math.atan2(this.y, this.x);
  }

  rotate(radians) {
    const c = Math.cos(radians);
    const s = Math.sin(radians);
    const nx = this.x * c - this.y * s;
    const ny = this.x * s + this.y * c;
    this.x = nx;
    this.y = ny;
    return this;
  }

  lerp(v, t) {
    this.x += (v.x - this.x) * t;
    this.y += (v.y - this.y) * t;
    return this;
  }

  perp() {
    const nx = -this.y;
    this.y = this.x;
    this.x = nx;
    return this;
  }

   reflect(normal) {
    const d = 2 * this.dot(normal);
    this.x -= d * normal.x;
    this.y -= d * normal.y;
    return this;
  }

  static add(a, b) {
    return new Vector2(a.x + b.x, a.y + b.y);
  }

  static sub(a, b) {
    return new Vector2(a.x - b.x, a.y - b.y);
  }

  static scale(v, s) {
    return new Vector2(v.x * s, v.y * s);
  }

  static fromAngle(radians, length = 1) {
    return new Vector2(Math.cos(radians) * length, Math.sin(radians) * length);
  }

  static dist(a, b) {
    return Math.sqrt(wasmCore.distSq(a.x, a.y, b.x, b.y));
  }

  static lerp(a, b, t) {
    return new Vector2(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t);
  }

  static cubicBezier(p0, p1, p2, p3, t) {
    const pt = wasmCore.cubicBezier(p0, p1, p2, p3, t);
    return new Vector2(pt.x, pt.y);
  }
}



// === src/engine/CloudPersistence.js ===
/**
 * CloudPersistence.js
 * Unified Firebase Realtime Database Cloud Sync + Arcade Emulator Save State Engine
 * + Hardware DIP Switch Store + Achievement & Telemetry System.
 *
 * Uses the exact same Firebase Realtime Database setup and validation schema as
 * Antigravity Party Games (`https://antigravity-party-games-rtdb-default-rtdb.firebaseio.com/antigravity_cloud/games`).
 */

const STORAGE_KEY = 'antigravity_cloud_stats_v1';
const FIREBASE_URL_KEY = 'antigravity_firebase_db_url';
const DEFAULT_FIREBASE_DB_URL = 'https://antigravity-party-games-rtdb-default-rtdb.firebaseio.com';
const SAVE_STATE_PREFIX = 'retro_arcade_savestate_v1_';
const DIP_STORAGE_KEY = 'retro_arcade_dip_switches_v1';
const ACHIEVEMENTS_STORAGE_KEY = 'retro_arcade_achievements_v1';
const INITIALS_STORAGE_KEY = 'retro_arcade_champion_initials_v1';

function hashString(str) {
  let h = 2166136261;
  for (let i = 0; i < str.length; i++) {
    h ^= str.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}

const FLAGSHIP_IDS = new Set([
  'loderunner',
  'digdug',
  'donkeykong',
  'sumo',
  'pacman',
  'frogger',
  'galaga',
  'spaceinvaders'
]);
class CloudPersistenceManager {
  constructor() {
    this.records = {};
    this.firebaseDatabaseUrl = null;
    this.writeDebounceTimers = new Map();
    this.syncStatus = 'local_only'; // 'local_only' | 'syncing' | 'synced' | 'offline_cached'
    this.lastSyncedAt = null;
    this.sortMode = 'default'; // 'default' | 'rating' | 'highscore' | 'saved' | 'most_played'

    this.detectFirebaseConfig();
    this.loadFromLocal();
    if (this.firebaseDatabaseUrl) {
      this.pullFromFirebase();
    }
    if (typeof window !== 'undefined') {
      window.__CLOUD_PERSISTENCE__ = this;
    }
  }

  static getInstance() {
    if (!CloudPersistenceManager._instance) {
      CloudPersistenceManager._instance = new CloudPersistenceManager();
    }
    return CloudPersistenceManager._instance;
  }

  detectFirebaseConfig() {
    try {
      if (typeof window !== 'undefined') {
        const params = new URLSearchParams(window.location ? window.location.search : '');
        const queryUrl = params.get('firebaseUrl') || params.get('firebase');
        if (queryUrl && queryUrl.startsWith('https://')) {
          localStorage.setItem(FIREBASE_URL_KEY, queryUrl.replace(/\/$/, ''));
        }
        const winCfg = window.__FIREBASE_CONFIG__;
        const storedUrl = localStorage.getItem(FIREBASE_URL_KEY);
        const url =
          queryUrl ||
          (winCfg && winCfg.databaseURL) ||
          storedUrl ||
          DEFAULT_FIREBASE_DB_URL ||
          null;
        if (url && url.startsWith('https://')) {
          this.firebaseDatabaseUrl = url.replace(/\/$/, '');
          this.syncStatus = 'offline_cached';
        }
      }
    } catch (_) {}
  }

  createDefaultRecord(gameId) {
    const id = String(gameId || '').toLowerCase();
    const h = hashString(id);
    const isFlagship = FLAGSHIP_IDS.has(id);
    const baseRating = isFlagship ? 4.8 + (h % 2) * 0.1 : 4.2 + (h % 75) / 100;
    const ratingCount = isFlagship ? 160 + (h % 90) : 28 + (h % 85);
    const saveCount = Math.round(ratingCount * (0.35 + ((h >> 4) % 30) / 100));
    const defaultHi = isFlagship ? 15000 + (h % 15) * 1000 : 11000 + (h % 12) * 1000;

    return {
      gameId: id,
      userRating: 0,
      communityRating: Number(baseRating.toFixed(1)),
      ratingCount,
      saved: false,
      saveCount,
      highScore: defaultHi,
      holder: 'ACE',
      wins: 0,
      plays: 0,
      fastestWinSec: null,
      lastPlayedAt: 0
    };
  }

  initializeCatalog(gameIds = []) {
    for (const id of gameIds) {
      const key = String(id).toLowerCase();
      if (!this.records[key]) {
        this.records[key] = this.createDefaultRecord(key);
      }
    }
  }

  getRecord(gameId) {
    const key = String(gameId || '').toLowerCase();
    if (!this.records[key]) {
      this.records[key] = this.createDefaultRecord(key);
    }
    return this.records[key];
  }

  getEffectiveRating(gameId) {
    const r = this.getRecord(gameId);
    if (r.userRating > 0) {
      const blended = r.userRating * 0.92 + r.communityRating * 0.08;
      return Number(blended.toFixed(2));
    }
    return r.communityRating;
  }

  notifyListeners(rec) {
    if (Array.isArray(this._updateListeners)) {
      this._updateListeners.forEach((cb) => {
        try {
          cb(rec);
        } catch (_) {}
      });
    }
  }

  rateGame(gameId, stars) {
    const clamped = Math.max(1, Math.min(5, Math.round(Number(stars) || 5)));
    const rec = this.getRecord(gameId);
    if (rec.userRating === 0) {
      rec.ratingCount += 1;
    }
    rec.userRating = clamped;
    this.saveToLocal();
    this.debouncedPush(rec);
    this.notifyListeners(rec);
    return rec;
  }

  cycleGameRating(gameId) {
    const rec = this.getRecord(gameId);
    const next = rec.userRating >= 5 ? 1 : (rec.userRating || 4) + 1;
    return this.rateGame(gameId, next);
  }

  toggleSaveGame(gameId) {
    const rec = this.getRecord(gameId);
    rec.saved = !rec.saved;
    rec.saveCount = Math.max(0, rec.saveCount + (rec.saved ? 1 : -1));
    this.saveToLocal();
    this.debouncedPush(rec);
    this.notifyListeners(rec);
    return rec.saved;
  }

  recordPlay(gameId) {
    const rec = this.getRecord(gameId);
    rec.plays = (rec.plays || 0) + 1;
    rec.lastPlayedAt = Date.now();
    this.saveToLocal();
    this.debouncedPush(rec);
    return rec;
  }

  recordScore(gameId, scorePoints, holderInitials = null) {
    const rec = this.getRecord(gameId);
    const numeric = Math.max(0, Math.floor(Number(scorePoints) || 0));
    const isNewHighScore = numeric > rec.highScore;
    if (isNewHighScore) {
      rec.highScore = numeric;
      if (holderInitials) {
        rec.holder = String(holderInitials).toUpperCase().slice(0, 3);
      }
      this.saveToLocal();
      this.debouncedPush(rec);
    } else if (holderInitials && numeric === rec.highScore) {
      rec.holder = String(holderInitials).toUpperCase().slice(0, 3);
      this.saveToLocal();
    }
    return { isNewHighScore, record: rec };
  }

  sortCatalog(games, mode = this.sortMode) {
    if (!mode || mode === 'default') return games;
    const copy = [...games];
    if (mode === 'saved') {
      return copy.filter((g) => this.getRecord(g.id).saved);
    }
    if (mode === 'rating') {
      return copy.sort((a, b) => {
        const diff = this.getEffectiveRating(b.id) - this.getEffectiveRating(a.id);
        if (Math.abs(diff) > 0.001) return diff;
        return this.getRecord(b.id).ratingCount - this.getRecord(a.id).ratingCount;
      });
    }
    if (mode === 'highscore') {
      return copy.sort((a, b) => this.getRecord(b.id).highScore - this.getRecord(a.id).highScore);
    }
    if (mode === 'most_played') {
      return copy.sort((a, b) => {
        const ra = this.getRecord(a.id);
        const rb = this.getRecord(b.id);
        if (rb.plays !== ra.plays) return rb.plays - ra.plays;
        return rb.saveCount - ra.saveCount;
      });
    }
    return copy;
  }

  loadFromLocal() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        if (parsed && typeof parsed === 'object') {
          this.records = parsed;
        }
      }
    } catch (_) {}
  }

  saveToLocal() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(this.records));
    } catch (_) {}
  }

  debouncedPush(rec) {
    if (typeof window === 'undefined') {
      this.pushRecordToFirebase(rec);
      return;
    }
    const timer = this.writeDebounceTimers.get(rec.gameId);
    if (timer) clearTimeout(timer);
    const newTimer = setTimeout(() => {
      this.writeDebounceTimers.delete(rec.gameId);
      this.pushRecordToFirebase(rec);
    }, 350);
    this.writeDebounceTimers.set(rec.gameId, newTimer);
  }

  async pullFromFirebase() {
    if (!this.firebaseDatabaseUrl || typeof fetch === 'undefined') return;
    try {
      this.syncStatus = 'syncing';
      const res = await fetch(`${this.firebaseDatabaseUrl}/antigravity_cloud/games.json`, {
        method: 'GET',
        headers: { Accept: 'application/json' }
      });
      if (!res.ok) {
        this.syncStatus = 'offline_cached';
        return;
      }
      const cloudData = await res.json();
      if (cloudData && typeof cloudData === 'object') {
        for (const [gameId, cloudRec] of Object.entries(cloudData)) {
          if (!cloudRec || typeof cloudRec !== 'object') continue;
          const local = this.getRecord(gameId);
          if (typeof cloudRec.highScore === 'number' && cloudRec.highScore > local.highScore) {
            local.highScore = cloudRec.highScore;
          }
          if (typeof cloudRec.communityRating === 'number') {
            local.communityRating = cloudRec.communityRating;
          }
          if (typeof cloudRec.ratingCount === 'number' && cloudRec.ratingCount > local.ratingCount) {
            local.ratingCount = cloudRec.ratingCount;
          }
          if (typeof cloudRec.saveCount === 'number' && cloudRec.saveCount > local.saveCount) {
            local.saveCount = cloudRec.saveCount;
          }
          if (typeof cloudRec.plays === 'number' && cloudRec.plays > local.plays) {
            local.plays = cloudRec.plays;
          }
        }
        this.saveToLocal();
      }
      this.syncStatus = 'synced';
      this.lastSyncedAt = Date.now();
    } catch (_) {
      this.syncStatus = 'offline_cached';
    }
  }

  async pushRecordToFirebase(rec, retryCount = 0) {
    if (!this.firebaseDatabaseUrl || typeof fetch === 'undefined') return;
    try {
      this.syncStatus = 'syncing';
      const endpoint = `${this.firebaseDatabaseUrl}/antigravity_cloud/games/${encodeURIComponent(rec.gameId)}.json`;

      let remote = null;
      try {
        const getRes = await fetch(endpoint, {
          method: 'GET',
          headers: { Accept: 'application/json' }
        });
        if (getRes.ok) {
          remote = await getRes.json();
        }
      } catch (_) {}

      const remoteExists = !!(remote && typeof remote === 'object' && typeof remote.highScore === 'number');
      const remoteHighScore = remoteExists && remote.highScore >= 0 ? remote.highScore : 0;
      const sanitizedLocalScore = Math.max(0, Math.min(5000000, Math.round(rec.highScore)));
      const maxInitialScore = remoteExists ? remoteHighScore + 100000 : 50000;
      const mergedHighScore = Math.min(maxInitialScore, Math.max(remoteHighScore, sanitizedLocalScore));
      rec.highScore = Math.max(rec.highScore, mergedHighScore);

      const remoteCount =
        remoteExists && typeof remote.ratingCount === 'number' && remote.ratingCount >= 0
          ? remote.ratingCount
          : Math.min(250, rec.ratingCount);
      const remoteRating =
        remoteExists &&
        typeof remote.communityRating === 'number' &&
        remote.communityRating >= 1 &&
        remote.communityRating <= 5
          ? remote.communityRating
          : Math.max(3.0, Math.min(5.0, rec.communityRating));

      const newRatingCount = remoteExists
        ? Math.max(remoteCount, Math.min(remoteCount + 1, rec.ratingCount))
        : Math.min(250, Math.max(1, rec.ratingCount));
      rec.ratingCount = newRatingCount;

      let mergedRating =
        rec.userRating > 0
          ? Number(
              (
                (remoteRating * Math.max(1, remoteCount) + rec.userRating) /
                (Math.max(1, remoteCount) + 1)
              ).toFixed(2)
            )
          : remoteRating;
      mergedRating = Math.max(3.0, Math.min(5.0, Number(mergedRating.toFixed(2))));
      if (remoteExists && remoteCount >= 5 && Math.abs(mergedRating - remoteRating) > 0.25) {
        mergedRating = Number(
          (remoteRating + Math.sign(mergedRating - remoteRating) * 0.2).toFixed(2)
        );
      }
      rec.communityRating = mergedRating;

      const remoteSaveCount =
        remoteExists && typeof remote.saveCount === 'number' && remote.saveCount >= 0
          ? remote.saveCount
          : Math.min(100, rec.saveCount);
      const mergedSaveCount = remoteExists
        ? Math.max(0, Math.min(remoteSaveCount + 1, Math.max(remoteSaveCount - 1, rec.saveCount)))
        : Math.min(100, Math.max(0, rec.saveCount));
      rec.saveCount = mergedSaveCount;

      const remotePlays =
        remoteExists && typeof remote.plays === 'number' && remote.plays >= 0 ? remote.plays : 0;
      const mergedPlays = remoteExists
        ? Math.max(remotePlays, Math.min(remotePlays + 5, rec.plays))
        : Math.min(50, Math.max(1, rec.plays));
      rec.plays = mergedPlays;

      const res = await fetch(endpoint, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          communityRating: mergedRating,
          ratingCount: newRatingCount,
          saveCount: mergedSaveCount,
          highScore: mergedHighScore,
          plays: mergedPlays
        })
      });

      if (!res.ok && retryCount < 1 && typeof window !== 'undefined') {
        setTimeout(() => this.pushRecordToFirebase(rec, retryCount + 1), 200);
        return;
      }

      this.saveToLocal();
      this.syncStatus = res.ok ? 'synced' : 'offline_cached';
      if (res.ok) this.lastSyncedAt = Date.now();
    } catch (_) {
      this.syncStatus = 'offline_cached';
    }
  }
}
const cloudPersistence = CloudPersistenceManager.getInstance();
const CloudPersistence = {
  init() {
    return cloudPersistence;
  },
  onUpdate(cb) {
    cloudPersistence._updateListeners = cloudPersistence._updateListeners || [];
    if (typeof cb === 'function') cloudPersistence._updateListeners.push(cb);
  },
  isFavorite(gameId) {
    return !!cloudPersistence.getRecord(gameId).saved;
  },
  toggleFavorite(gameId) {
    return cloudPersistence.toggleSaveGame(gameId);
  },
  recordPlay(gameId) {
    return cloudPersistence.recordPlay(gameId);
  },
  submitHighScore(gameId, score, initials = 'ACE') {
    return cloudPersistence.recordScore(gameId, score, initials);
  }
};

/**
 * Deep State Serializer for Arcade Emulator Save States & Real-Time Rewind Ring Buffer
 */
const EXCLUDED_GAME_KEYS = new Set([
  'renderer',
  'input',
  'audio',
  'wasm',
  'ctx',
  'displayCanvas',
  'bufferCanvas'
]);
class SaveStateManager {
  static serializeValue(val, seen = new WeakSet(), depth = 0) {
    if (val === null || val === undefined) return val;
    const t = typeof val;
    if (t === 'number' || t === 'string' || t === 'boolean') return val;
    if (t === 'function') return undefined;
    if (depth > 9) return null;

    if (typeof val === 'object') {
      if (seen.has(val)) return undefined;
      // Handle DOM / Canvas / Audio nodes safely
      if (
        (typeof Element !== 'undefined' && val instanceof Element) ||
        (typeof AudioNode !== 'undefined' && val instanceof AudioNode)
      ) {
        return undefined;
      }

      seen.add(val);
      try {
        if (val instanceof Vector2 || (val.constructor && val.constructor.name === 'Vector2')) {
          return { __type: 'Vector2', x: val.x, y: val.y };
        }
        if (val instanceof Map) {
          const entries = [];
          for (const [k, v] of val.entries()) {
            entries.push([k, SaveStateManager.serializeValue(v, seen, depth + 1)]);
          }
          return { __type: 'Map', entries };
        }
        if (val instanceof Set) {
          const values = [];
          for (const v of val.values()) {
            values.push(SaveStateManager.serializeValue(v, seen, depth + 1));
          }
          return { __type: 'Set', values };
        }
        if (val instanceof Uint8Array) {
          return { __type: 'Uint8Array', data: Array.from(val) };
        }
        if (val instanceof Float32Array) {
          return { __type: 'Float32Array', data: Array.from(val) };
        }
        if (Array.isArray(val)) {
          return val.map((item) => SaveStateManager.serializeValue(item, seen, depth + 1));
        }

        const out = {};
        for (const key of Object.keys(val)) {
          if (EXCLUDED_GAME_KEYS.has(key)) continue;
          const sv = SaveStateManager.serializeValue(val[key], seen, depth + 1);
          if (sv !== undefined) {
            out[key] = sv;
          }
        }
        return out;
      } finally {
        seen.delete(val);
      }
    }
    return undefined;
  }

  static deserializeValue(val) {
    if (val === null || val === undefined) return val;
    if (typeof val !== 'object') return val;

    if (Array.isArray(val)) {
      return val.map((item) => SaveStateManager.deserializeValue(item));
    }

    if (val.__type === 'Vector2') {
      return new Vector2(val.x, val.y);
    }
    if (val.__type === 'Map') {
      const m = new Map();
      if (Array.isArray(val.entries)) {
        for (const [k, v] of val.entries) {
          m.set(k, SaveStateManager.deserializeValue(v));
        }
      }
      return m;
    }
    if (val.__type === 'Set') {
      const s = new Set();
      if (Array.isArray(val.values)) {
        for (const v of val.values) {
          s.add(SaveStateManager.deserializeValue(v));
        }
      }
      return s;
    }
    if (val.__type === 'Uint8Array') {
      return new Uint8Array(val.data || []);
    }
    if (val.__type === 'Float32Array') {
      return new Float32Array(val.data || []);
    }

    const out = {};
    for (const key of Object.keys(val)) {
      out[key] = SaveStateManager.deserializeValue(val[key]);
    }
    return out;
  }

  static captureSnapshot(game) {
    if (!game) return null;
    const seen = new WeakSet();
    const state = {};
    for (const key of Object.keys(game)) {
      if (EXCLUDED_GAME_KEYS.has(key)) continue;
      const serialized = SaveStateManager.serializeValue(game[key], seen, 0);
      if (serialized !== undefined) {
        state[key] = serialized;
      }
    }
    return {
      gameId: game.id,
      title: game.title,
      score: game.score || 0,
      level: game.level || 1,
      lives: game.lives || 3,
      timestamp: Date.now(),
      state
    };
  }

  static restoreSnapshot(game, snapshot) {
    if (!game || !snapshot || !snapshot.state) return false;
    const restored = SaveStateManager.deserializeValue(snapshot.state);
    for (const key of Object.keys(restored)) {
      if (EXCLUDED_GAME_KEYS.has(key)) continue;
      game[key] = restored[key];
    }
    return true;
  }

  static createSnapshot(game) {
    return SaveStateManager.captureSnapshot(game);
  }

  static applySnapshot(game, snapshot) {
    return SaveStateManager.restoreSnapshot(game, snapshot);
  }

  static save(gameId, game) {
    return !!SaveStateManager.saveToSlot(game, 1);
  }

  static load(gameId, game) {
    return !!SaveStateManager.loadFromSlot(game, 1);
  }

  static hasSave(gameId) {
    return !!SaveStateManager.getSlotMeta(gameId, 1);
  }

  static saveToSlot(game, slot = 1) {
    if (!game || !game.id) return null;
    const snap = SaveStateManager.captureSnapshot(game);
    if (!snap) return null;
    const keyLower = String(game.id || '').toLowerCase();
    const storageKey = `${SAVE_STATE_PREFIX}${keyLower}_slot_${slot}`;
    try {
      localStorage.setItem(storageKey, JSON.stringify(snap));
    } catch (_) {}
    if (!SaveStateManager._slotMetaCache) {
      SaveStateManager._slotMetaCache = new Map();
    }
    SaveStateManager._slotMetaCache.set(storageKey, {
      slot,
      score: snap.score || 0,
      level: snap.level || 1,
      lives: snap.lives || 3,
      timestamp: snap.timestamp || 0
    });
    return snap;
  }

  static loadFromSlot(game, slot = 1) {
    if (!game || !game.id) return null;
    const storageKey = `${SAVE_STATE_PREFIX}${String(game.id || '').toLowerCase()}_slot_${slot}`;
    try {
      const raw = localStorage.getItem(storageKey);
      if (!raw) return null;
      const snap = JSON.parse(raw);
      if (SaveStateManager.restoreSnapshot(game, snap)) {
        return snap;
      }
    } catch (_) {}
    return null;
  }

  static getSlotMeta(gameId, slot = 1) {
    const storageKey = `${SAVE_STATE_PREFIX}${String(gameId || '').toLowerCase()}_slot_${slot}`;
    if (!SaveStateManager._slotMetaCache) {
      SaveStateManager._slotMetaCache = new Map();
    }
    if (SaveStateManager._slotMetaCache.has(storageKey)) {
      return SaveStateManager._slotMetaCache.get(storageKey);
    }
    try {
      const raw = localStorage.getItem(storageKey);
      if (!raw) {
        SaveStateManager._slotMetaCache.set(storageKey, null);
        return null;
      }
      const snap = JSON.parse(raw);
      const meta = {
        slot,
        score: snap.score || 0,
        level: snap.level || 1,
        lives: snap.lives || 3,
        timestamp: snap.timestamp || 0
      };
      SaveStateManager._slotMetaCache.set(storageKey, meta);
      return meta;
    } catch (_) {
      SaveStateManager._slotMetaCache.set(storageKey, null);
      return null;
    }
  }
}

/**
 * Hardware DIP Switch Store (Lives, Difficulty, Free Play, Rapid Fire)
 */
const DEFAULT_DIP = {
  startingLives: 3, // 2 | 3 | 5
  difficulty: 'NORMAL', // 'EASY' | 'NORMAL' | 'HARD'
  freePlay: false, // Infinite lives regeneration
  rapidFire: false // 15 Hz auto-fire on Action A/B
};
class DipSwitchStore {
  static get() {
    if (DipSwitchStore._cachedDip) {
      return DipSwitchStore._cachedDip;
    }
    try {
      const raw = localStorage.getItem(DIP_STORAGE_KEY);
      if (!raw) {
        DipSwitchStore._cachedDip = { ...DEFAULT_DIP };
      } else {
        DipSwitchStore._cachedDip = { ...DEFAULT_DIP, ...JSON.parse(raw) };
      }
    } catch (_) {
      DipSwitchStore._cachedDip = { ...DEFAULT_DIP };
    }
    return DipSwitchStore._cachedDip;
  }

  static save(next) {
    const merged = { ...DipSwitchStore.get(), ...next };
    DipSwitchStore._cachedDip = merged;
    DipSwitchStore._cachedPreset = null;
    try {
      localStorage.setItem(DIP_STORAGE_KEY, JSON.stringify(merged));
    } catch (_) {}
    return merged;
  }

  static getDifficultyScale() {
    const d = DipSwitchStore.get().difficulty;
    if (d === 'EASY') return 0.85;
    if (d === 'HARD') return 1.22;
    return 1.0;
  }

  static getPreset() {
    if (DipSwitchStore._cachedPreset) {
      return DipSwitchStore._cachedPreset;
    }
    const cur = DipSwitchStore.get();
    const label =
      cur.difficulty === 'EASY'
        ? 'EASY 5-LIVES'
        : cur.difficulty === 'HARD'
        ? 'HARD 2-LIVES'
        : `${cur.startingLives} LIVES STD`;
    DipSwitchStore._cachedPreset = {
      label,
      lives: cur.startingLives,
      difficultyName: cur.difficulty,
      speedScale: DipSwitchStore.getDifficultyScale()
    };
    return DipSwitchStore._cachedPreset;
  }

  static cyclePreset() {
    const cur = DipSwitchStore.get();
    if (cur.difficulty === 'NORMAL' && cur.startingLives === 3) {
      DipSwitchStore.save({ startingLives: 5, difficulty: 'NORMAL' });
    } else if (cur.difficulty === 'NORMAL' && cur.startingLives === 5) {
      DipSwitchStore.save({ startingLives: 2, difficulty: 'HARD' });
    } else if (cur.difficulty === 'HARD') {
      DipSwitchStore.save({ startingLives: 5, difficulty: 'EASY', freePlay: true });
    } else {
      DipSwitchStore.save({ startingLives: 3, difficulty: 'NORMAL', freePlay: false });
    }
    return DipSwitchStore.getPreset();
  }
}

/**
 * Champion 3-Letter Initials Store
 */
class InitialsStore {
  static getLastInitials() {
    if (InitialsStore._cachedInitials) {
      return InitialsStore._cachedInitials;
    }
    try {
      InitialsStore._cachedInitials = localStorage.getItem(INITIALS_STORAGE_KEY) || 'ACE';
    } catch (_) {
      InitialsStore._cachedInitials = 'ACE';
    }
    return InitialsStore._cachedInitials;
  }

  static setLastInitials(initials) {
    const clean = String(initials || 'ACE')
      .toUpperCase()
      .replace(/[^A-Z0-9]/g, 'A')
      .padEnd(3, 'A')
      .slice(0, 3);
    InitialsStore._cachedInitials = clean;
    try {
      localStorage.setItem(INITIALS_STORAGE_KEY, clean);
    } catch (_) {}
    return clean;
  }

  static cycleChar(cursorIdx = 0, delta = 1) {
    const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
    const current = InitialsStore.getLastInitials().split('');
    const idx = Math.max(0, Math.min(2, cursorIdx));
    const pos = Math.max(0, alphabet.indexOf(current[idx]));
    current[idx] = alphabet[(pos + delta + alphabet.length) % alphabet.length];
    return InitialsStore.setLastInitials(current.join(''));
  }
}

/**
 * In-Studio Achievement Badges & Toast Notification Manager
 */
const ACHIEVEMENT_DEFS = [
  { id: 'first_coin', title: 'FIRST QUARTER INSERTED', desc: 'Launch your first classic arcade cabinet' },
  { id: 'high_roller', title: 'TWIN GALAXIES CONTENDER', desc: 'Score over 25,000 points in any cabinet' },
  { id: 'stage_veteran', title: 'STAGE 3 MASTER', desc: 'Reach Level 3 or higher in any cabinet' },
  { id: 'time_traveler', title: 'CHRONO REWINDER', desc: 'Use the Rewind Time-Machine buffer' },
  { id: 'save_master', title: 'EMULATOR ARCHIVIST', desc: 'Save or Load an Emulator Save State' },
  { id: 'arcade_critic', title: 'COMMUNITY CRITIC', desc: 'Rate or Bookmark a game in Cloud Sync' },
  { id: 'crt_connoisseur', title: 'PHOSPHOR CONNOISSEUR', desc: 'Cycle through CRT Monitor Shader presets' },
  { id: 'cabinet_tour', title: 'ARCADE FLOOR TOURIST', desc: 'Play 5 different classic cabinets' }
];
class AchievementManager {
  constructor() {
    this.unlocked = new Set();
    this.playedGames = new Set();
    this.activeToasts = [];
    this.load();
  }

  load() {
    try {
      const raw = localStorage.getItem(ACHIEVEMENTS_STORAGE_KEY);
      if (raw) {
        const arr = JSON.parse(raw);
        if (Array.isArray(arr)) {
          arr.forEach((id) => this.unlocked.add(id));
        }
      }
    } catch (_) {}
  }

  save() {
    try {
      localStorage.setItem(ACHIEVEMENTS_STORAGE_KEY, JSON.stringify(Array.from(this.unlocked)));
    } catch (_) {}
  }

  unlock(id, audio = null) {
    if (this.unlocked.has(id)) return false;
    const def = ACHIEVEMENT_DEFS.find((a) => a.id === id);
    if (!def) return false;
    this.unlocked.add(id);
    this.save();
    this.pushToast(`🏆 ${def.title}`, def.desc, '#FFD700');
    if (audio && typeof audio.playPowerUp === 'function') {
      audio.playPowerUp();
    }
    return true;
  }

  pushToast(title, subtitle = '', color = '#00F0FF') {
    this.activeToasts.push({
      title,
      subtitle,
      color,
      timer: 3.2,
      maxTimer: 3.2
    });
    if (this.activeToasts.length > 3) {
      this.activeToasts.shift();
    }
  }

  update(dt) {
    for (let i = this.activeToasts.length - 1; i >= 0; i--) {
      this.activeToasts[i].timer -= dt;
      if (this.activeToasts[i].timer <= 0) {
        this.activeToasts.splice(i, 1);
      }
    }
  }

  static unlock(id, audio = null) {
    const norm = String(id || '').toLowerCase();
    const map = {
      first_coin: 'first_coin',
      high_roller_10k: 'high_roller',
      stage_conqueror: 'stage_veteran',
      time_traveler: 'time_traveler',
      save_master: 'save_master',
      shutterbug: 'crt_connoisseur'
    };
    const targetId = map[norm] || norm;
    const unlocked = achievementManager.unlock(targetId, audio);
    if (!unlocked) return null;
    const def = ACHIEVEMENT_DEFS.find((a) => a.id === targetId);
    return def ? { icon: '🏆', title: def.title, desc: def.desc } : null;
  }
}
const achievementManager = new AchievementManager();


// === src/engine/Input.js ===
/**
 * Input.js
 * Unified Input Event Controller handling physical keyboard, mouse/pointer,
 * canvas swipe/tap gestures, W3C Gamepad API, Rapid-Fire Auto-Turbo latch,
 * Attract-Mode Demo AI inputs, and mobile touch overlay controls simultaneously.
 */
class InputManager {
  constructor(canvas = null) {
    this.canvas = canvas;
    this.logicalWidth = 960;
    this.logicalHeight = 540;

    this.virtualState = {
      up: false,
      down: false,
      left: false,
      right: false,
      actionA: false,
      actionB: false,
      pause: false,
      menu: false
    };

    this.keyState = {
      up: false,
      down: false,
      left: false,
      right: false,
      actionA: false,
      actionB: false,
      pause: false,
      menu: false
    };

    this.touchState = {
      up: false,
      down: false,
      left: false,
      right: false,
      actionA: false,
      actionB: false,
      axisX: 0,
      axisY: 0
    };

    this.gamepadState = {
      connected: false,
      count: 0,
      name: '',
      up: false,
      down: false,
      left: false,
      right: false,
      actionA: false,
      actionB: false,
      pause: false,
      menu: false,
      select: false,
      start: false,
      l1: false,
      r1: false,
      l2: false,
      r2: false,
      l3: false,
      r3: false,
      axisX: 0,
      axisY: 0,
      rightAxisX: 0,
      rightAxisY: 0,
      rewindHeld: false,
      saveState: false,
      loadState: false,
      fastForward: false,
      favorite: false,
      nextTab: false,
      prevTab: false
    };

    this._gamepadSaveLatched = false;
    this._gamepadLoadLatched = false;
    this._gamepadFastForwardLatched = false;
    this._gamepadFavoriteLatched = false;
    this._gamepadNextTabLatched = false;
    this._gamepadPrevTabLatched = false;
    this._gamepadSelectLatched = false;
    this._gamepadStartLatched = false;
    this.onGamepadConnected = null;
    this.onGamepadDisconnected = null;

    this.attractState = {
      active: false,
      up: false,
      down: false,
      left: false,
      right: false,
      actionA: false,
      actionB: false
    };

    this.rawKeysDown = new Set();
    this.rawKeysJustPressed = new Set();

    // Hardware Rapid-Fire Turbo Auto-Fire (15 Hz pulse when held)
    this.turboEnabled = false;
    this._turboTick = 0;

    this.prevState = { ...this.virtualState };
    // Edge-latched presses so rapid keydown+keyup between frames is never missed
    this.latchedPress = {
      up: false,
      down: false,
      left: false,
      right: false,
      actionA: false,
      actionB: false,
      pause: false,
      menu: false
    };

    this.pointer = {
      x: 480,
      y: 270,
      down: false,
      justPressed: false,
      justReleased: false,
      isTouch: false,
      get isDown() {
        return this.down;
      }
    };

    this.lastSwipe = null;
    this._swipeStart = null;
    this.onPauseCallback = null;
    this.onMenuCallback = null;
    this.onFirstInteraction = null;
    this.onUserActivity = null;
    this._interacted = false;

    this.mounted = false;
    this._boundListeners = [];
    this.logicalWidth = 960;
    this.logicalHeight = 540;

    this.initKeyboard();
    this.initGamepad();
    this.initTouchOverlay();
    if (this.canvas) {
      this.bindCanvasPointer(this.canvas);
    }
    this.mount();
  }

  get keysDown() {
    return this.rawKeysDown;
  }

  _addManagedListener(target, type, handler, options) {
    if (!target || typeof target.addEventListener !== 'function') return;
    target.addEventListener(type, handler, options);
    this._boundListeners.push({ target, type, handler, options });
  }

  _notifyInteraction() {
    if (!this._interacted) {
      this._interacted = true;
      if (typeof this.onFirstInteraction === 'function') {
        this.onFirstInteraction();
      }
    }
    if (typeof this.onUserActivity === 'function') {
      this.onUserActivity();
    }
  }

  initKeyboard() {
    this._keyMap = {
      ArrowUp: 'up',
      KeyW: 'up',
      ArrowDown: 'down',
      KeyS: 'down',
      ArrowLeft: 'left',
      KeyA: 'left',
      ArrowRight: 'right',
      KeyD: 'right',
      KeyZ: 'actionA',
      Space: 'actionA',
      Enter: 'actionA',
      KeyJ: 'actionA',
      KeyX: 'actionB',
      ShiftLeft: 'actionB',
      ShiftRight: 'actionB',
      KeyK: 'actionB',
      KeyP: 'pause',
      Escape: 'pause',
      Backspace: 'menu'
    };

    this._onKeyDown = (e) => {
      // Ignore if typing in an input element
      if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA')) {
        return;
      }
      this._notifyInteraction();
      if (!this.rawKeysDown.has(e.code)) {
        this.rawKeysJustPressed.add(e.code);
      }
      this.rawKeysDown.add(e.code);

      const action = this._keyMap[e.code];
      if (action) {
        e.preventDefault();
        if (!this.keyState[action]) {
          this.latchedPress[action] = true;
          if (action === 'pause' && typeof this.onPauseCallback === 'function') {
            this.onPauseCallback();
          }
          if (action === 'menu' && typeof this.onMenuCallback === 'function') {
            this.onMenuCallback();
          }
        }
        this.keyState[action] = true;
        this.syncVirtualState();
      }
    };

    this._onKeyUp = (e) => {
      this.rawKeysDown.delete(e.code);
      const action = this._keyMap[e.code];
      if (action) {
        this.keyState[action] = false;
        this.syncVirtualState();
      }
    };

    this._onBlur = () => {
      this.resetState();
    };
  }

  initGamepad() {
    this._onGamepadConnected = (e) => {
      this._notifyInteraction();
      this.pollGamepads();
      if (typeof this.onGamepadConnected === 'function') {
        const pad = e.gamepad || (e.detail && e.detail.gamepad);
        this.onGamepadConnected(pad);
      }
    };

    this._onGamepadDisconnected = (e) => {
      this.pollGamepads();
      if (typeof this.onGamepadDisconnected === 'function') {
        const pad = e.gamepad || (e.detail && e.detail.gamepad);
        this.onGamepadDisconnected(pad);
      }
    };
  }

  initTouchOverlay() {
    if (typeof document !== 'undefined' && document.body) {
      this.touchControls = new TouchControls(this, document.body);
    }
  }

  bindCanvasPointer(canvas, logicalWidth = 960, logicalHeight = 540) {
    this.canvas = canvas;
    this.logicalWidth = logicalWidth;
    this.logicalHeight = logicalHeight;

    const toLogicalCoords = (clientX, clientY) => {
      if (!this.canvas) return { x: 480, y: 270 };
      const rect = this.canvas.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) return { x: 480, y: 270 };
      const x = ((clientX - rect.left) / rect.width) * this.logicalWidth;
      const y = ((clientY - rect.top) / rect.height) * this.logicalHeight;
      return {
        x: Math.max(0, Math.min(this.logicalWidth, x)),
        y: Math.max(0, Math.min(this.logicalHeight, y))
      };
    };

    this._onCanvasMouseMove = (e) => {
      const pt = toLogicalCoords(e.clientX, e.clientY);
      this.pointer.x = pt.x;
      this.pointer.y = pt.y;
    };

    this._onCanvasMouseDown = (e) => {
      if (e.button !== 0) return;
      this._notifyInteraction();
      const pt = toLogicalCoords(e.clientX, e.clientY);
      this.pointer.x = pt.x;
      this.pointer.y = pt.y;
      this.pointer.down = true;
      this.pointer.justPressed = true;
      this.pointer.isTouch = false;
      this._swipeStart = { x: pt.x, y: pt.y, time: performance.now() };
    };

    this._onWindowMouseUp = () => {
      if (this.pointer.down) {
        this.pointer.down = false;
        this.pointer.justReleased = true;
      }
    };

    this._onCanvasTouchStart = (e) => {
      this._notifyInteraction();
      if (e.changedTouches.length > 0) {
        const t = e.changedTouches[0];
        const pt = toLogicalCoords(t.clientX, t.clientY);
        this.pointer.x = pt.x;
        this.pointer.y = pt.y;
        this.pointer.down = true;
        this.pointer.justPressed = true;
        this.pointer.isTouch = true;
        this._swipeStart = { x: pt.x, y: pt.y, time: performance.now() };
      }
    };

    this._onCanvasTouchMove = (e) => {
      if (e.changedTouches.length > 0) {
        const t = e.changedTouches[0];
        const pt = toLogicalCoords(t.clientX, t.clientY);
        this.pointer.x = pt.x;
        this.pointer.y = pt.y;
        if (this._swipeStart) {
          const dx = pt.x - this._swipeStart.x;
          const dy = pt.y - this._swipeStart.y;
          if (Math.hypot(dx, dy) > 28) {
            if (Math.abs(dx) > Math.abs(dy)) {
              this.lastSwipe = dx > 0 ? 'right' : 'left';
            } else {
              this.lastSwipe = dy > 0 ? 'down' : 'up';
            }
            this._swipeStart = { x: pt.x, y: pt.y, time: performance.now() };
          }
        }
      }
    };

    this._onCanvasTouchEnd = (e) => {
      if (e.changedTouches.length > 0) {
        const t = e.changedTouches[0];
        const pt = toLogicalCoords(t.clientX, t.clientY);
        if (this._swipeStart) {
          const dx = pt.x - this._swipeStart.x;
          const dy = pt.y - this._swipeStart.y;
          if (Math.hypot(dx, dy) > 24) {
            if (Math.abs(dx) > Math.abs(dy)) {
              this.lastSwipe = dx > 0 ? 'right' : 'left';
            } else {
              this.lastSwipe = dy > 0 ? 'down' : 'up';
            }
          }
