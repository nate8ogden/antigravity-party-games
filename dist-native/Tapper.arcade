/**
 * Renderer.js
 * Core 16:9 Scalable Viewport & 2D-to-WebGL Framebuffer Renderer for Retro Arcade Studio.
 * Coordinates offscreen 2D canvas drawing, particle/shake effects, pixel-art sprite matrices,
 * HighScore LocalStorage + Firebase Cloud Sync persistence, 3-Initial Champion Entry,
 * Rewind VHS overlay, Achievement Toasts, and the WebGL CRT Post-Processing pipeline.
 */
const PALETTE = {
  BG: '#0B0F19',     // Deep space background
  CYAN: '#00F0FF',   // Electric Cyan
  PINK: '#FF007A',   // Neon Pink
  GOLD: '#FFD700',   // Arcade Gold
  GREEN: '#00FF66',  // Vivid Green
  ORANGE: '#FF8800',
  PURPLE: '#B829FF',
  RED: '#FF2A55',
  BLUE: '#38BDF8',
  WHITE: '#F8FAFC',
  MUTED: '#94A3B8',
  PANEL: '#131B2E'
};
const FONTS = {
  HEADER: "'Press Start 2P', 'Courier New', monospace",
  HUD: "'Space Grotesk', system-ui, -apple-system, sans-serif",
  BODY: "'Inter', system-ui, -apple-system, sans-serif"
};

const HIGHSCORE_STORAGE_KEY = 'retro_arcade_studio_highscores_v1';
const HOLDERS_STORAGE_KEY = 'retro_arcade_studio_holders_v1';

const DEFAULT_HIGHSCORES = {
  loderunner: 12500,
  digdug: 18400,
  donkeykong: 22000,
  sumo: 9500,
  pacman: 25600,
  frogger: 14200,
  galaga: 30000,
  spaceinvaders: 16500,
  asteroids: 15000,
  centipede: 14000,
  defender: 19500,
  arkanoid: 17000,
  paperboy: 11000,
  joust: 13500,
  qbert: 12800,
  rampage: 16000,
  marblemadness: 14500,
  pitfall: 15400,
  duckhunt: 12000,
  excitebike: 13200,
  missilecommand: 14800,
  burgertime: 13600,
  bubblebobble: 16800,
  spyhunter: 15200,
  tron: 11800,
  trackandfield: 10500,
  outrun: 24000,
  contra: 21000,
  galaxian: 14200,
  digdug2: 15800,
  elevatoraction: 16500,
  tapper: 13900,
  lunarlander: 11500,
  tempest: 22400,
  robotron: 28000,
  sinistar: 25600,
  crystalcastles: 17200,
  zaxxon: 19400,
  moonpatrol: 14600,
  pengo: 15200,
  rallyx: 13800,
  roadfighter: 16400,
  flicky: 14900,
  game1942: 19420,
  circuscharlie: 13400,
  battlecity: 18200,
  kungfumaster: 19800,
  wildgunman: 12600,
  exerion: 15100,
  tetrisretro: 24500
};
class HighScoreStore {
  static loadAll() {
    if (HighScoreStore._scoresCache) {
      return HighScoreStore._scoresCache;
    }
    try {
      const raw = localStorage.getItem(HIGHSCORE_STORAGE_KEY);
      let scores;
      if (!raw) {
        localStorage.setItem(HIGHSCORE_STORAGE_KEY, JSON.stringify(DEFAULT_HIGHSCORES));
        scores = { ...DEFAULT_HIGHSCORES };
      } else {
        const parsed = JSON.parse(raw);
        scores = { ...DEFAULT_HIGHSCORES, ...parsed };
      }
      // Merge with Firebase Cloud Persistence records
      for (const id of Object.keys(scores)) {
        const cloudRec = cloudPersistence.getRecord(id);
        if (cloudRec.highScore > scores[id]) {
          scores[id] = cloudRec.highScore;
        } else if (scores[id] > cloudRec.highScore) {
          cloudRec.highScore = scores[id];
        }
      }
      HighScoreStore._scoresCache = scores;
      return scores;
    } catch (_) {
      HighScoreStore._scoresCache = { ...DEFAULT_HIGHSCORES };
      return HighScoreStore._scoresCache;
    }
  }

  static get(gameId) {
    const key = String(gameId || '').toLowerCase();
    const all = HighScoreStore.loadAll();
    const cloudRec = cloudPersistence.getRecord(key);
    return Math.max(all[key] || 5000, cloudRec.highScore || 0);
  }

  static getHolder(gameId) {
    const key = String(gameId || '').toLowerCase();
    if (!HighScoreStore._holdersCache) {
      try {
        const raw = localStorage.getItem(HOLDERS_STORAGE_KEY);
        HighScoreStore._holdersCache = raw ? JSON.parse(raw) || {} : {};
      } catch (_) {
        HighScoreStore._holdersCache = {};
      }
    }
    if (HighScoreStore._holdersCache[key]) {
      return HighScoreStore._holdersCache[key];
    }
    const cloudRec = cloudPersistence.getRecord(key);
    return cloudRec.holder || 'ACE';
  }

  static setHolder(gameId, initials) {
    const key = String(gameId || '').toLowerCase();
    const clean = InitialsStore.setLastInitials(initials);
    if (!HighScoreStore._holdersCache) {
      HighScoreStore.getHolder(key);
    }
    HighScoreStore._holdersCache[key] = clean;
    try {
      localStorage.setItem(HOLDERS_STORAGE_KEY, JSON.stringify(HighScoreStore._holdersCache));
    } catch (_) {}
    const cloudRec = cloudPersistence.getRecord(key);
    cloudRec.holder = clean;
    cloudPersistence.saveToLocal();
    return clean;
  }

  static submit(gameId, score, holderInitials = null) {
    const key = String(gameId || '').toLowerCase();
    const numeric = Math.floor(Number(score) || 0);
    const all = HighScoreStore.loadAll();
    const prev = all[key] || 0;
    const isNew = numeric > prev;
    const initials = holderInitials || InitialsStore.getLastInitials();
    if (isNew) {
      all[key] = numeric;
      try {
        localStorage.setItem(HIGHSCORE_STORAGE_KEY, JSON.stringify(all));
      } catch (_) {}
      HighScoreStore.setHolder(key, initials);
    }
    // Sync to Firebase Cloud Persistence
    cloudPersistence.recordScore(key, Math.max(prev, numeric), isNew ? initials : null);
    if (numeric >= 25000) {
      achievementManager.unlock('high_roller');
    }
    return { highScore: Math.max(prev, numeric), isNew };
  }
}
class Renderer {
  constructor(displayCanvas, viewportContainer = null) {
    this.width = 960;
    this.height = 540;
    this.displayCanvas = displayCanvas;
    this.viewportContainer =
      viewportContainer || (displayCanvas ? displayCanvas.parentElement : null);

    // Offscreen 2D framebuffer where all games draw
    this.bufferCanvas = document.createElement('canvas');
    this.bufferCanvas.width = this.width;
    this.bufferCanvas.height = this.height;
    this.ctx = this.bufferCanvas.getContext('2d');
    this.ctx.imageSmoothingEnabled = false;

    if (this.displayCanvas) {
      this.displayCanvas.width = this.width;
      this.displayCanvas.height = this.height;
    }

    // Wrap the display canvas in the WebGL CRT post-processing shader pipeline
    this.crt = new CRTOverlay(this.displayCanvas, this.bufferCanvas);
    this.wasm = wasmCore;

    this.shakeTime = 0;
    this.shakeIntensity = 0;
    this.flashAlpha = 0;
    this.rewinding = false;
    this.attractMode = false;
    this.timeScale = 1.0;

    // 3-Initial Champion Entry State on Game Over
    this.initialsChars = InitialsStore.getLastInitials().split('');
    this.initialsCursor = 0;

    this.resizeViewport();
    this._onResize = () => this.resizeViewport();
    window.addEventListener('resize', this._onResize);
    window.addEventListener('orientationchange', this._onResize);
  }

  /**
   * Responsive 16:9 viewport scaling across Desktop, Tablet, and Mobile Phone (Portrait & Landscape)
   */
  resizeViewport() {
    if (!this.displayCanvas || !this.viewportContainer) return;
    const rect = this.viewportContainer.getBoundingClientRect();
    this._lastVpW = rect.width || window.innerWidth || 960;
    this._lastVpH = rect.height || window.innerHeight || 540;
    const touchEl =
      typeof document !== 'undefined' ? document.getElementById('arcade-touch-overlay') : null;
    const touchVisible = !!(touchEl && touchEl.classList.contains('visible'));
    const winW = window.innerWidth || rect.width || 960;
    const winH = window.innerHeight || rect.height || 540;
    const isPortrait = winH >= winW;
    const isPhoneLandscape = !isPortrait && winH <= 520 && touchVisible;

    let reservedSides = 0;
    if (isPhoneLandscape) {
      // In compact phone landscape, D-Pad and Action A/B sit in left/right gutters
      reservedSides = Math.min(240, Math.max(170, winW * 0.25));
    }

    // Note: CSS padding-bottom on .arcade-viewport already reserves bottom touch space when needed,
    // so we measure the inner content box of .arcade-viewport directly to avoid double-subtracting!
    const style =
      typeof window !== 'undefined' && window.getComputedStyle
        ? window.getComputedStyle(this.viewportContainer)
        : null;
    const padTop = style ? parseFloat(style.paddingTop) || 0 : 6;
    const padBot = style ? parseFloat(style.paddingBottom) || 0 : 6;
    const padLeft = style ? parseFloat(style.paddingLeft) || 0 : 6;
    const padRight = style ? parseFloat(style.paddingRight) || 0 : 6;

    const rawW = rect.width > 40 ? rect.width : winW;
    const rawH = rect.height > 40 ? rect.height : Math.max(240, winH - 90);
    const availW = Math.max(200, rawW - padLeft - padRight - reservedSides - 6);
    const availH = Math.max(120, rawH - padTop - padBot - 6);
    const targetAspect = 16 / 9;

    let drawW = availW;
    let drawH = drawW / targetAspect;
    if (drawH > availH) {
      drawH = availH;
      drawW = drawH * targetAspect;
    }

    this.displayCanvas.style.width = `${Math.floor(drawW)}px`;
    this.displayCanvas.style.height = `${Math.floor(drawH)}px`;
  }

  shake(intensity = 6, duration = 0.2) {
    this.shakeIntensity = Math.max(this.shakeIntensity, intensity);
    this.shakeTime = Math.max(this.shakeTime, duration);
  }

  triggerFlash(alpha = 0.85) {
    this.flashAlpha = alpha;
  }

  beginFrame(dt = 0.016) {
    this._frameTick = ((this._frameTick || 0) + 1) % 30;
    if (this._frameTick === 0 && this.viewportContainer) {
      const cw = this.viewportContainer.clientWidth || 0;
      const ch = this.viewportContainer.clientHeight || 0;
      if (cw > 40 && ch > 40 && (Math.abs(cw - (this._lastVpW || 0)) > 4 || Math.abs(ch - (this._lastVpH || 0)) > 4)) {
        this.resizeViewport();
      }
    }
    const ctx = this.ctx;
    ctx.save();
    ctx.fillStyle = PALETTE.BG;
    ctx.fillRect(0, 0, this.width, this.height);

    if (this.shakeTime > 0) {
      this.shakeTime = Math.max(0, this.shakeTime - dt);
      const ox = (Math.random() * 2 - 1) * this.shakeIntensity;
      const oy = (Math.random() * 2 - 1) * this.shakeIntensity;
      ctx.translate(ox, oy);
      if (this.shakeTime <= 0) {
        this.shakeIntensity = 0;
      }
    }

    if (this.flashAlpha > 0) {
      this.flashAlpha = Math.max(0, this.flashAlpha - dt * 2.8);
    }

    achievementManager.update(dt);
  }

  endFrame() {
    const ctx = this.ctx;
    ctx.restore();

    // 1. Rewind Time-Machine VHS Scan Bar Overlay
    if (this.rewinding || (this.rewindOverlay && this.rewindOverlay.active)) {
      ctx.save();
      ctx.fillStyle = 'rgba(0, 240, 255, 0.14)';
      ctx.fillRect(0, 0, this.width, this.height);
      const barY = ((performance.now() * 0.45) % this.height);
      ctx.fillStyle = 'rgba(255, 255, 255, 0.22)';
      ctx.fillRect(0, barY, this.width, 18);
      this.drawText('⏪ REWINDING TIME-MACHINE', this.width / 2, 74, {
        font: FONTS.HEADER,
        size: 16,
        color: PALETTE.CYAN,
        align: 'center',
        glow: 14
      });
      ctx.restore();
    }

    // 2. Attract Mode Demo Banner
    if (this.attractMode || (this.attractOverlay && this.attractOverlay.active)) {
      const blink = Math.floor(performance.now() / 420) % 2 === 0;
      ctx.save();
      ctx.fillStyle = 'rgba(11, 15, 25, 0.82)';
      ctx.strokeStyle = PALETTE.GOLD;
      ctx.lineWidth = 2;
      ctx.fillRect(190, 488, 580, 36);
      ctx.strokeRect(190, 488, 580, 36);
      if (blink) {
        this.drawText(
          '🎬 ATTRACT DEMO MODE — PRESS ANY KEY OR TAP TO INSERT COIN',
          this.width / 2,
          511,
          {
            font: FONTS.HEADER,
            size: 10.5,
            color: PALETTE.GOLD,
            align: 'center',
            glow: 10
          }
        );
      }
      ctx.restore();
    }

    // 3. Achievement & Emulator Save State Toast Notifications
    if (achievementManager.activeToasts.length > 0) {
      ctx.save();
      achievementManager.activeToasts.forEach((t, idx) => {
        const y = 46 + idx * 52;
        const x = this.width - 332;
        ctx.fillStyle = 'rgba(15, 23, 42, 0.95)';
        ctx.strokeStyle = t.color || PALETTE.GOLD;
        ctx.lineWidth = 2;
        ctx.shadowColor = t.color || PALETTE.GOLD;
        ctx.shadowBlur = 12;
        ctx.fillRect(x, y, 320, 44);
        ctx.strokeRect(x, y, 320, 44);
        ctx.shadowBlur = 0;

        this.drawText(t.title, x + 12, y + 19, {
          font: FONTS.HEADER,
          size: 9.5,
          color: t.color || PALETTE.GOLD
        });
        if (t.subtitle) {
          this.drawText(t.subtitle, x + 12, y + 36, {
            font: FONTS.BODY,
            size: 11,
            color: PALETTE.WHITE,
            bold: false
          });
        }
      });
      ctx.restore();
    }

    // 4. Screenshot Shutter Flash
    if (this.flashAlpha > 0) {
      ctx.save();
      ctx.fillStyle = `rgba(255, 255, 255, ${this.flashAlpha.toFixed(2)})`;
      ctx.fillRect(0, 0, this.width, this.height);
      ctx.restore();
    }

    this.crt.render();
  }

  clear(color = PALETTE.BG) {
    this.ctx.fillStyle = color;
    this.ctx.fillRect(0, 0, this.width, this.height);
  }

  drawGlowRect(x, y, w, h, color, _blur = 10, fill = true, lineWidth = 2) {
    const ctx = this.ctx;
    if (fill) {
      ctx.fillStyle = color;
      ctx.fillRect(x, y, w, h);
    } else {
      ctx.strokeStyle = color;
      ctx.lineWidth = lineWidth;
      ctx.strokeRect(x, y, w, h);
    }
  }

  drawGlowCircle(x, y, r, color, _blur = 10, fill = true, lineWidth = 2) {
    const ctx = this.ctx;
    ctx.beginPath();
    ctx.arc(x, y, Math.max(0.5, r), 0, Math.PI * 2);
    if (fill) {
      ctx.fillStyle = color;
      ctx.fill();
    } else {
      ctx.strokeStyle = color;
      ctx.lineWidth = lineWidth;
      ctx.stroke();
    }
  }

  drawText(
    text,
    x,
    y,
    {
      font = FONTS.HUD,
      size = 16,
      color = PALETTE.WHITE,
      align = 'left',
      baseline = 'alphabetic',
      bold = true
    } = {}
  ) {
    const ctx = this.ctx;
    ctx.font = `${bold ? '700 ' : ''}${size}px ${font}`;
    ctx.fillStyle = color;
    ctx.textAlign = align;
    ctx.textBaseline = baseline;
    ctx.fillText(String(text), x, y);
  }

  /**
   * Renders a pixel art matrix where each character in strings maps to a hex color
   */
  drawPixelSprite(rows, x, y, scale = 2, palette = {}, flipX = false, flipY = false) {
    const ctx = this.ctx;
    const h = rows.length;
    const w = rows[0] ? rows[0].length : 0;
    for (let r = 0; r < h; r++) {
      const rowStr = rows[r];
      for (let c = 0; c < w; c++) {
        const ch = rowStr[c];
        if (ch === '.' || ch === ' ' || !palette[ch]) continue;
        const drawC = flipX ? w - 1 - c : c;
        const drawR = flipY ? h - 1 - r : r;
        ctx.fillStyle = palette[ch];
        ctx.fillRect(
          Math.round(x + drawC * scale),
          Math.round(y + drawR * scale),
          Math.ceil(scale),
          Math.ceil(scale)
        );
      }
    }
  }

  /**
   * Draws a game-specific miniature pixel-art life icon in the arcade HUD
   */
  _drawLifeIcon(ctx, titleUpper, x, y, accent = PALETTE.CYAN) {
    ctx.save();
    if (titleUpper.includes('PAC')) {
      // Classic yellow Pac-Man profile wedge facing left
      ctx.fillStyle = PALETTE.GOLD;
      ctx.beginPath();
      ctx.arc(x + 6, y + 6, 5.5, 1.25 * Math.PI, 0.75 * Math.PI, false);
      ctx.lineTo(x + 6, y + 6);
      ctx.closePath();
      ctx.fill();
    } else if (
      titleUpper.includes('GALAGA') ||
      titleUpper.includes('GALAXIAN') ||
      titleUpper.includes('DEFENDER') ||
      titleUpper.includes('SINISTAR') ||
      titleUpper.includes('EXERION') ||
      titleUpper.includes('ZAXXON') ||
      titleUpper.includes('STAR') ||
      titleUpper.includes('HORIZON') ||
      titleUpper.includes('INERTIA')
    ) {
      // Classic white/red Namco starfighter icon
      ctx.fillStyle = PALETTE.WHITE;
      ctx.fillRect(x + 5, y + 1, 2, 10);
      ctx.fillRect(x + 3, y + 4, 6, 5);
      ctx.fillRect(x + 1, y + 6, 10, 4);
      ctx.fillStyle = PALETTE.RED;
      ctx.fillRect(x + 1, y + 5, 2, 2);
      ctx.fillRect(x + 9, y + 5, 2, 2);
      ctx.fillRect(x + 5, y + 4, 2, 3);
    } else if (titleUpper.includes('INVADER') || titleUpper.includes('ARMADA')) {
      // Classic Taito green laser cannon base
      ctx.fillStyle = PALETTE.GREEN;
      ctx.fillRect(x + 5, y + 2, 2, 3);
      ctx.fillRect(x + 3, y + 5, 6, 2);
      ctx.fillRect(x + 1, y + 7, 10, 4);
    } else if (titleUpper.includes('FROG') || titleUpper.includes('HOPPER')) {
      // Mini green frog with yellow eyes
      ctx.fillStyle = PALETTE.GREEN;
      ctx.fillRect(x + 3, y + 3, 6, 7);
      ctx.fillRect(x + 1, y + 2, 2, 3);
      ctx.fillRect(x + 9, y + 2, 2, 3);
      ctx.fillRect(x + 1, y + 8, 2, 3);
      ctx.fillRect(x + 9, y + 8, 2, 3);
      ctx.fillStyle = PALETTE.GOLD;
      ctx.fillRect(x + 3, y + 2, 2, 2);
      ctx.fillRect(x + 7, y + 2, 2, 2);
    } else if (titleUpper.includes('DIG') || titleUpper.includes('DRILLER')) {
      // Mini Taizo Hori white/blue helmet
      ctx.fillStyle = PALETTE.WHITE;
      ctx.fillRect(x + 2, y + 1, 8, 9);
      ctx.fillStyle = PALETTE.CYAN;
      ctx.fillRect(x + 3, y + 3, 6, 3);
      ctx.fillStyle = PALETTE.RED;
      ctx.fillRect(x + 3, y + 9, 6, 2);
    } else if (
      titleUpper.includes('KONG') ||
      titleUpper.includes('GIRDER') ||
      titleUpper.includes('LODE') ||
      titleUpper.includes('VAULT') ||
      titleUpper.includes('PITFALL') ||
      titleUpper.includes('CONTRA') ||
      titleUpper.includes('COMMANDO') ||
      titleUpper.includes('KUNG')
    ) {
      // Mini Jumpman / Hero cap & face
      ctx.fillStyle = PALETTE.RED;
      ctx.fillRect(x + 2, y + 1, 8, 3);
      ctx.fillRect(x + 4, y + 3, 7, 2);
      ctx.fillStyle = '#FDE68A';
      ctx.fillRect(x + 3, y + 5, 6, 4);
      ctx.fillStyle = PALETTE.BLUE;
      ctx.fillRect(x + 3, y + 9, 6, 3);
    } else if (
      titleUpper.includes('ASTEROID') ||
      titleUpper.includes('METEOR') ||
      titleUpper.includes('LANDER') ||
      titleUpper.includes('TEMPEST') ||
      titleUpper.includes('VORTEX')
    ) {
      // Glowing vector A-frame ship
      ctx.strokeStyle = accent || PALETTE.CYAN;
      ctx.lineWidth = 1.6;
      ctx.beginPath();
      ctx.moveTo(x + 6, y + 1);
      ctx.lineTo(x + 11, y + 11);
      ctx.lineTo(x + 8, y + 9);
      ctx.lineTo(x + 4, y + 9);
      ctx.lineTo(x + 1, y + 11);
      ctx.closePath();
      ctx.stroke();
    } else if (
      titleUpper.includes('OUTRUN') ||
      titleUpper.includes('SPY') ||
      titleUpper.includes('HIGHWAY') ||
      titleUpper.includes('RALLY') ||
      titleUpper.includes('ROAD') ||
      titleUpper.includes('TRON') ||
      titleUpper.includes('LIGHT')
    ) {
      // Mini top-down race car
      ctx.fillStyle = PALETTE.RED;
      ctx.fillRect(x + 3, y + 1, 6, 10);
      ctx.fillStyle = PALETTE.CYAN;
      ctx.fillRect(x + 4, y + 3, 4, 3);
      ctx.fillStyle = PALETTE.WHITE;
      ctx.fillRect(x + 1, y + 2, 2, 3);
      ctx.fillRect(x + 9, y + 2, 2, 3);
      ctx.fillRect(x + 1, y + 7, 2, 3);
      ctx.fillRect(x + 9, y + 7, 2, 3);
    } else if (titleUpper.includes('BATTLE') || titleUpper.includes('TANK')) {
      // Mini golden tank
      ctx.fillStyle = PALETTE.GOLD;
      ctx.fillRect(x + 1, y + 3, 2, 8);
      ctx.fillRect(x + 9, y + 3, 2, 8);
      ctx.fillRect(x + 3, y + 4, 6, 6);
      ctx.fillRect(x + 5, y + 1, 2, 4);
    } else if (titleUpper.includes('Q*BERT') || titleUpper.includes('ISO HOP')) {
      // Mini orange Q*bert head & snout
      ctx.fillStyle = PALETTE.ORANGE;
      ctx.beginPath();
      ctx.arc(x + 5, y + 6, 4.5, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillRect(x + 7, y + 5, 4, 3);
      ctx.fillStyle = PALETTE.WHITE;
      ctx.fillRect(x + 3, y + 3, 3, 3);
    } else if (titleUpper.includes('BUBBLE')) {
      // Mini green Bub dragon
      ctx.fillStyle = PALETTE.GREEN;
      ctx.fillRect(x + 2, y + 2, 8, 8);
      ctx.fillStyle = PALETTE.GOLD;
      ctx.fillRect(x + 1, y + 3, 2, 5);
      ctx.fillStyle = PALETTE.WHITE;
      ctx.fillRect(x + 6, y + 3, 3, 3);
    } else if (titleUpper.includes('BURGER') || titleUpper.includes('BISTRO')) {
      // Mini white Chef hat
      ctx.fillStyle = PALETTE.WHITE;
      ctx.fillRect(x + 2, y + 1, 8, 5);
      ctx.fillRect(x + 3, y + 6, 6, 3);
      ctx.fillStyle = '#FDBA74';
      ctx.fillRect(x + 3, y + 9, 6, 3);
    } else {
      // Classic arcade heart / badge icon
      ctx.fillStyle = accent || PALETTE.PINK;
      ctx.fillRect(x + 2, y + 2, 3, 3);
      ctx.fillRect(x + 7, y + 2, 3, 3);
      ctx.fillRect(x + 1, y + 4, 10, 4);
      ctx.fillRect(x + 3, y + 8, 6, 2);
      ctx.fillRect(x + 5, y + 10, 2, 2);
    }
    ctx.restore();
  }

  /**
   * Draws classic Namco/Taito style stage pennant flags next to the stage counter
   */
  _drawStageFlags(ctx, level, x, y) {
    ctx.save();
    const tens = Math.min(3, Math.floor(level / 10));
    const ones = Math.min(4, level % 10);
    let curX = x;
    for (let i = 0; i < tens; i++) {
      // Large Red/Gold 10-Stage Pennant
      ctx.fillStyle = PALETTE.WHITE;
      ctx.fillRect(curX, y, 1.5, 13);
      ctx.fillStyle = PALETTE.RED;
      ctx.beginPath();
      ctx.moveTo(curX + 1.5, y);
      ctx.lineTo(curX + 9, y + 4);
      ctx.lineTo(curX + 1.5, y + 8);
      ctx.closePath();
      ctx.fill();
      ctx.fillStyle = PALETTE.GOLD;
      ctx.fillRect(curX + 2, y + 3, 4, 2);
      curX += 10;
    }
    for (let i = 0; i < ones; i++) {
      // Classic Yellow/Red 1-Stage Pennant
      ctx.fillStyle = PALETTE.WHITE;
      ctx.fillRect(curX, y + 1, 1.5, 12);
      ctx.fillStyle = PALETTE.GOLD;
      ctx.beginPath();
      ctx.moveTo(curX + 1.5, y + 1);
      ctx.lineTo(curX + 7, y + 4);
      ctx.lineTo(curX + 1.5, y + 7);
      ctx.closePath();
      ctx.fill();
      curX += 7;
    }
    ctx.restore();
  }

  /**
   * Draws an authentic 1980s coin-op top arcade HUD bar (38px height)
   */
  drawHUD({
    title = 'ARCADE',
    score = 0,
    highScore = 0,
    lives = 3,
    level = 1,
    extraLabel = '',
    accent = PALETTE.CYAN
  } = {}) {
    const ctx = this.ctx;
    const titleUpper = String(title || 'ARCADE').toUpperCase();
    ctx.save();

    // Pitch-black coin-op marquee header strip with double neon trim
    ctx.fillStyle = '#04060C';
    ctx.fillRect(0, 0, this.width, 38);
    ctx.strokeStyle = accent;
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(0, 36.5);
    ctx.lineTo(this.width, 36.5);
    ctx.stroke();
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.16)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(0, 34);
    ctx.lineTo(this.width, 34);
    ctx.stroke();

    // 1. Classic Arcade Marquee Title (left)
    const displayTitle = titleUpper.length > 16 ? titleUpper.slice(0, 16) : titleUpper;
    this.drawText(displayTitle, 12, 23, {
      font: FONTS.HEADER,
      size: displayTitle.length > 13 ? 10 : 11.5,
      color: accent,
      glow: 8
    });

    // 2. Classic Coin-Op 1UP Header + 6-Digit Bitmap Score
    const blink1UP = Math.floor(performance.now() / 360) % 2 === 0;
    this.drawText('1UP', 238, 13, {
      font: FONTS.HEADER,
      size: 7.5,
      color: blink1UP ? PALETTE.RED : PALETTE.WHITE
    });
    this.drawText(String(Math.floor(score)).padStart(6, '0'), 238, 28, {
      font: FONTS.HEADER,
      size: 11,
      color: PALETTE.WHITE
    });

    // 3. HIGH SCORE + Champion Initials in Arcade Gold
    const holder = InitialsStore.getLastInitials();
    this.drawText(`HIGH SCORE (${holder})`, 365, 13, {
      font: FONTS.HEADER,
      size: 7.5,
      color: PALETTE.GOLD
    });
    this.drawText(
      String(Math.floor(Math.max(score, highScore))).padStart(6, '0'),
      365,
      28,
      {
        font: FONTS.HEADER,
        size: 11,
        color: PALETTE.GOLD,
        glow: 6
      }
    );

    // 4. Stage Counter + Classic Arcade Stage Pennant Flags
    this.drawText(`RD:${String(level).padStart(2, '0')}`, 542, 24, {
      font: FONTS.HEADER,
      size: 9.5,
      color: PALETTE.GREEN
    });
    this._drawStageFlags(ctx, level, 600, 12);

    // 5. Game-specific status telemetry (e.g. GOLD, BONUS, BAYS, FUEL)
    if (extraLabel) {
      const cleanExtra = String(extraLabel).length > 22 ? String(extraLabel).slice(0, 22) : extraLabel;
      this.drawText(cleanExtra, 642, 24, {
        font: FONTS.HEADER,
        size: 8,
        color: PALETTE.CYAN
      });
    }

    // 6. Game-Specific Pixel-Art Life Icons on far right
    const maxLivesIcons = Math.max(0, Math.min(6, lives));
    for (let i = 0; i < maxLivesIcons; i++) {
      this._drawLifeIcon(ctx, titleUpper, 864 + i * 15, 12, accent);
    }
    ctx.restore();
  }

  /**
   * Authentic 1980s Coin-Op Attract / Pause / Game Over Cabinet Overlay
   */
  drawStateOverlay(
    state,
    {
      title = '',
      subtitle = '',
      controls = 'ARROWS/WASD: MOVE  |  Z/SPACE: ACTION A  |  X/SHIFT: ACTION B  |  P: PAUSE',
      score = 0,
      highScore = 0,
      accent = PALETTE.CYAN
    } = {}
  ) {
    if (state === 'PLAYING') return;
    const ctx = this.ctx;
    ctx.save();
    ctx.fillStyle = 'rgba(4, 6, 12, 0.84)';
    ctx.fillRect(0, 38, this.width, this.height - 38);

    const boxW = 660;
    const boxH = 304;
    const bx = (this.width - boxW) / 2;
    const by = (this.height - boxH) / 2 + 12;
    const frameCol = state === 'GAMEOVER' ? PALETTE.PINK : accent;

    // Outer & inner double-line coin-op cabinet frame
    ctx.fillStyle = 'rgba(10, 15, 28, 0.97)';
    ctx.fillRect(bx, by, boxW, boxH);
    ctx.strokeStyle = frameCol;
    ctx.lineWidth = 3;
    ctx.shadowColor = frameCol;
    ctx.shadowBlur = 16;
    ctx.strokeRect(bx, by, boxW, boxH);
    ctx.shadowBlur = 0;

    ctx.strokeStyle = PALETTE.GOLD;
    ctx.lineWidth = 1.2;
    ctx.strokeRect(bx + 6, by + 6, boxW - 12, boxH - 12);

    // Corner arcade rivets
    ctx.fillStyle = PALETTE.GOLD;
    for (const [rx, ry] of [
      [bx + 10, by + 10],
      [bx + boxW - 14, by + 10],
      [bx + 10, by + boxH - 14],
      [bx + boxW - 14, by + boxH - 14]
    ]) {
      ctx.fillRect(rx, ry, 4, 4);
    }

    const pulse = 0.65 + 0.35 * Math.sin(performance.now() * 0.006);
    const blinkCoin = Math.floor(performance.now() / 420) % 2 === 0;

    if (state === 'MENU') {
      this.drawText(title.toUpperCase(), this.width / 2, by + 56, {
        font: FONTS.HEADER,
        size: 22,
        color: accent,
        align: 'center',
        glow: 12
      });
      this.drawText(subtitle || 'AUTHENTIC COIN-OP ARCADE EDITION', this.width / 2, by + 90, {
        font: FONTS.HEADER,
        size: 10,
        color: PALETTE.GOLD,
        align: 'center'
      });
      this.drawText(controls, this.width / 2, by + 138, {
        font: FONTS.HUD,
        size: 13,
        color: PALETTE.WHITE,
        align: 'center'
      });
      ctx.globalAlpha = pulse;
      this.drawText(
        blinkCoin
          ? 'INSERT COIN  •  PRESS [SPACE / Z / TAP] FOR 1P START'
          : 'PUSH 1P START BUTTON [SPACE / Z / TAP]',
        this.width / 2,
        by + 196,
        {
          font: FONTS.HEADER,
          size: 12,
          color: PALETTE.GREEN,
          align: 'center',
          glow: 10
        }
      );
      ctx.globalAlpha = 1;
      this.drawText(
        `TOP SCORE: ${String(highScore).padStart(6, '0')} (${InitialsStore.getLastInitials()})   •   CREDIT 01 (FREE PLAY)`,
        this.width / 2,
        by + 242,
        {
          font: FONTS.HEADER,
          size: 9.5,
          color: PALETTE.GOLD,
          align: 'center'
        }
      );
      this.drawText('© 1978-1989 RETRO ARCADE STUDIO ARCHIVE', this.width / 2, by + 276, {
        font: FONTS.HEADER,
        size: 8,
        color: PALETTE.MUTED,
        align: 'center'
      });
    } else if (state === 'PAUSED') {
      this.drawText('PAUSE / DIP SWITCHES', this.width / 2, by + 60, {
        font: FONTS.HEADER,
        size: 20,
        color: PALETTE.GOLD,
        align: 'center',
        glow: 12
      });
      this.drawText(controls, this.width / 2, by + 114, {
        font: FONTS.HUD,
        size: 13,
        color: PALETTE.WHITE,
        align: 'center'
      });
      this.drawText(
        '[F5] SAVE STATE  |  [F8] LOAD STATE  |  [.] FRAME STEP  |  [R] REWIND',
        this.width / 2,
        by + 156,
        {
          font: FONTS.HEADER,
          size: 9,
          color: PALETTE.GOLD,
          align: 'center'
        }
      );
      ctx.globalAlpha = pulse;
      this.drawText(
        'PRESS [P / SPACE / Z] TO RESUME  |  [BACKSPACE] ARCADE LOBBY',
        this.width / 2,
        by + 216,
        {
          font: FONTS.HEADER,
          size: 10.5,
          color: PALETTE.CYAN,
          align: 'center'
        }
      );
      ctx.globalAlpha = 1;
      this.drawText('CREDIT 01  •  CRT SCANLINE EMULATION ACTIVE', this.width / 2, by + 268, {
        font: FONTS.HEADER,
        size: 8,
        color: PALETTE.MUTED,
        align: 'center'
      });
    } else if (state === 'GAMEOVER') {
      this.drawText('GAME OVER', this.width / 2, by + 54, {
        font: FONTS.HEADER,
        size: 24,
        color: PALETTE.PINK,
        align: 'center',
        glow: 14
      });
      this.drawText(
        `1UP SCORE: ${String(Math.floor(score)).padStart(6, '0')}    HIGH: ${String(
          Math.floor(Math.max(score, highScore))
        ).padStart(6, '0')}`,
        this.width / 2,
        by + 96,
        {
          font: FONTS.HEADER,
          size: 11.5,
          color: PALETTE.WHITE,
          align: 'center'
        }
      );

      // 3-Initial Arcade Champion Selector
      const chars = this.initialsChars || ['A', 'C', 'E'];
      this.drawText(
        `ENTER INITIALS (UP/DOWN CHAR, L/R SLOT):  [ ${chars[0]} ] [ ${chars[1]} ] [ ${chars[2]} ]`,
        this.width / 2,
        by + 140,
        {
          font: FONTS.HEADER,
          size: 10,
          color: PALETTE.GOLD,
          align: 'center',
          glow: 8
        }
      );

      this.drawText(
        'PRESS [F8] TO LOAD SAVED STATE OR HOLD [R] TO REWIND!',
        this.width / 2,
        by + 180,
        {
          font: FONTS.HEADER,
          size: 8.5,
          color: PALETTE.CYAN,
          align: 'center'
        }
      );

      ctx.globalAlpha = pulse;
      this.drawText(
        blinkCoin
          ? 'INSERT COIN  •  PRESS [SPACE / Z / TAP] TO CONTINUE'
          : 'PRESS [SPACE / Z / TAP] TO PLAY AGAIN',
        this.width / 2,
        by + 226,
        {
          font: FONTS.HEADER,
          size: 11.5,
          color: PALETTE.GREEN,
          align: 'center',
          glow: 8
        }
      );
      ctx.globalAlpha = 1;
      this.drawText('OR CLICK [STUDIO LOBBY] TO SWITCH CABINETS', this.width / 2, by + 266, {
        font: FONTS.HEADER,
        size: 8.5,
        color: PALETTE.MUTED,
        align: 'center'
      });
    }

    ctx.restore();
  }

  pushToast(opts = {}) {
    if (!opts) return;
    achievementManager.pushToast(
      `${opts.icon ? opts.icon + ' ' : ''}${opts.title || 'ARCADE NOTICE'}`,
      opts.desc || opts.subtitle || '',
      opts.color || PALETTE.CYAN
    );
  }

  triggerShutterFlash() {
    this.shutterFlashTimer = 0.25;
    this.flashAlpha = 0.85;
  }

  destroy() {
    if (typeof window !== 'undefined' && this._onResize) {
      window.removeEventListener('resize', this._onResize);
      window.removeEventListener('orientationchange', this._onResize);
    }
  }
}


// === src/games/Tapper.js ===
/**
 * Tapper.js
 * Classic 1983 Bally Midway Arcade Action Game (Root Beer Tapper / Root Beer Dash).
 *
 * Features:
 * - 4 parallel saloon bar counters at y = 140, 240, 340, 440 with brass keg taps on the right
 * - UP/DOWN teleports the bartender between the 4 bar taps; LEFT/RIGHT runs along the counter
 *   to catch returning empty mugs and collect tip bills (+500 pts + Can-Can Show distraction!)
 * - ACTION A fills & slides a frosty root beer mug down the counter; ACTION B quick-snaps to tap
 * - 4 distinct saloon themes across levels (Western Saloon, Sports Grill, Punk Club, Cosmic Cantina)
 */

const SPRITES = {
  BARTENDER: [
    '...KKKKKK...',
    '..KKKKKKKK..',
    '..FFFFFFFF..',
    '..FFKKKKFF..',
    '...FFFFFF...',
    '..WWWWWWWW..',
    '.WWRRRRRRWW.',
    '.WWRRRRRRWW.',
    '..RRRRRRRR..',
    '...KK..KK...'
  ],
  PATRON: [
    '...HHHHHH...',
    '..HHHHHHHH..',
    '...FFFFFF...',
    '..CCCCCCCC..',
    '.CCCCCCCCCC.',
    '..CCCCCCCC..',
    '...BBBBBB...',
    '...BB..BB...',
    '..KK....KK..'
  ],
  MUG_FULL: [
    '.WWWWWW.',
    'WWWWWWWW',
    'GGGGGGGG',
    'GGGGGGGG',
    'GGGGGGGG',
    'GGGGGGGG',
    '.GGGGGG.'
  ],
  MUG_EMPTY: [
    '........',
    '.WWWWWW.',
    '.W....W.',
    '.W....W.',
    '.W....W.',
    '.W....W.',
    '.WWWWWW.'
  ]
};

const BARTENDER_PALETTE = {
  K: '#1E293B',
  F: '#FDBA74',
  W: PALETTE.WHITE,
  R: PALETTE.RED
};

const MUG_PALETTE = {
  W: PALETTE.WHITE,
  G: '#D97706'
};

const VENUE_THEMES = [
  {
    id: 'western',
    name: 'WESTERN SALOON',
    bgFill: '#1C120C',
    lineStroke: 'rgba(120, 53, 15, 0.35)',
    barBase: '#451A03',
    barTop: '#92400E',
    barTrim: '#F59E0B',
    doorFill: '#78350F',
    kegFill: '#78350F',
    skinColor: '#FDBA74',
    hatColors: ['#92400E', '#B45309', '#78350F', '#D97706'],
    shirtColors: ['#DC2626', '#2563EB', '#D97706', '#059669'],
    dancerBanner: '💃 SALOON CAN-CAN SHOW! COWBOYS DISTRACTED! 💃'
  },
  {
    id: 'sports',
    name: 'SPORTS TAVERN',
    bgFill: '#06281E',
    lineStroke: 'rgba(16, 185, 129, 0.25)',
    barBase: '#1E293B',
    barTop: '#047857',
    barTrim: '#FACC15',
    doorFill: '#065F46',
    kegFill: '#334155',
    skinColor: '#FDBA74',
    hatColors: ['#EF4444', '#3B82F6', '#FACC15', '#F8FAFC'],
    shirtColors: ['#F8FAFC', '#EF4444', '#2563EB', '#10B981'],
    dancerBanner: '📣 CHEERLEADER HALFTIME SHOW! JOCKS DISTRACTED! 📣'
  },
  {
    id: 'punk',
    name: 'PUNK ROCK CLUB',
    bgFill: '#160B24',
    lineStroke: 'rgba(236, 72, 153, 0.28)',
    barBase: '#2E1065',
    barTop: '#701A75',
    barTrim: '#FF007A',
    doorFill: '#4C1D95',
    kegFill: '#1E1B4B',
    skinColor: '#FDE68A',
    hatColors: ['#FF007A', '#00FF66', '#00F0FF', '#FACC15'],
    shirtColors: ['#111827', '#9333EA', '#BE185D', '#1E293B'],
    dancerBanner: '🎸 PUNK ROCKSTAGE SOLO! HEADBANGERS DISTRACTED! 🎸'
  },
  {
    id: 'space',
    name: 'SPACE CANTINA',
    bgFill: '#060D1F',
    lineStroke: 'rgba(56, 189, 248, 0.25)',
    barBase: '#0F172A',
    barTop: '#0369A1',
    barTrim: '#00F0FF',
    doorFill: '#1E3A8A',
    kegFill: '#0284C7',
    skinColor: '#4ADE80',
    hatColors: ['#00F0FF', '#C084FC', '#38BDF8', '#F472B6'],
    shirtColors: ['#6366F1', '#0284C7', '#EC4899', '#14B8A6'],
    dancerBanner: '🛸 HOLO-DANCER NEXUS! ALIENS DISTRACTED! 🛸'
  }
];
class Tapper {
  constructor(renderer, input, audio) {
    this.renderer = renderer;
    this.input = input;
    this.audio = audio;

    this.id = 'tapper';
    this.title = 'Tapper';
    this.state = 'PLAYING';

    this.width = 960;
    this.height = 540;
    this.highScore = HighScoreStore.get(this.id);

    // 4 parallel saloon bar counters at y = 140, 240, 340, 440
    this.bars = [
      { y: 140, leftX: 150, rightX: 800, tapX: 822 },
      { y: 240, leftX: 125, rightX: 815, tapX: 837 },
      { y: 340, leftX: 100, rightX: 830, tapX: 852 },
      { y: 440, leftX: 75, rightX: 845, tapX: 867 }
    ];

    this.reset();
  }

  reset() {
    this.score = 0;
    this.highScore = HighScoreStore.get(this.id);
    this.lives = 3;
    this.level = 1;
    this._setupWave(this.level);
  }

  setState(state) {
    this.state = state;
  }

  destroy() {
    if (this.audio) {
      this.audio.stopSequence();
    }
  }

  _setupWave(level) {
    this.bartender = {
      barIdx: 0,
      x: this.bars[0].tapX,
      y: this.bars[0].y,
      pouringTimer: 0,
      speed: 280
    };

    this.patrons = [];
    this.mugs = []; // { barIdx, x, vx, full: true|false }
    this.tips = []; // { barIdx, x, timer }
    this.particles = [];
    this.floatingTexts = [];

    this.patronsRemainingToSpawn = 10 + level * 4;
    this.spawnTimer = 0.6;
    this.showDancerTimer = 0;

    this.venue = VENUE_THEMES[(level - 1) % VENUE_THEMES.length];
    this.themeName = this.venue.name;
    this.bannerText = `STAGE ${level}: ${this.themeName}`;
    this.bannerTimer = 2.0;

    // Spawn 1 patron on each bar immediately
    for (let b = 0; b < 4; b++) {
      this._spawnPatron(b, this.bars[b].leftX + 20 + b * 14);
      this.patronsRemainingToSpawn = Math.max(0, this.patronsRemainingToSpawn - 1);
    }
  }

  _spawnPatron(barIdx, customX = null) {
    const bar = this.bars[barIdx];
    const venue = this.venue || VENUE_THEMES[0];
    const colors = venue.shirtColors;
    const hats = venue.hatColors;
    this.patrons.push({
      barIdx,
      x: customX !== null ? customX : bar.leftX + 8,
      y: bar.y,
      speed: 42 + Math.min(48, this.level * 5.5) + Math.random() * 14,
      state: 'advancing', // 'advancing' | 'drinking' | 'distracted'
      drinkTimer: 0,
      hasSentEmpty: false,
      skinColor: venue.skinColor,
      shirtColor: colors[(barIdx + this.patrons.length) % colors.length],
      hatColor: hats[(barIdx + this.patrons.length) % hats.length]
    });
  }

  update(dt) {
    const clampedDt = Math.min(dt, 0.05);

    if (this.state === 'MENU' || this.state === 'GAMEOVER') {
      if (this.input.isJustPressed('actionA') || this.input.isJustPressed('any')) {
        this.audio.playMenuSelect();
        this.reset();
        this.state = 'PLAYING';
      }
      return;
    }

    if (this.state === 'PAUSED') {
      if (this.input.isJustPressed('pause') || this.input.isJustPressed('actionA')) {
        this.audio.playMenuSelect();
        this.state = 'PLAYING';
      }
      return;
    }

    if (this.input.isJustPressed('pause')) {
      this.audio.playMenuMove();
      this.state = 'PAUSED';
      return;
    }

    if (this.bannerTimer > 0) {
      this.bannerTimer = Math.max(0, this.bannerTimer - clampedDt);
    }
    if (this.showDancerTimer > 0) {
      this.showDancerTimer = Math.max(0, this.showDancerTimer - clampedDt);
    }

    this._updateBartender(clampedDt);
    this._updateMugs(clampedDt);
    this._updatePatrons(clampedDt);
    this._updateTips(clampedDt);
    this._updateParticles(clampedDt);

    // Check stage clear
    const activeMugs = this.mugs.length;
    if (this.patrons.length === 0 && this.patronsRemainingToSpawn <= 0 && activeMugs === 0) {
      this.score += 1000;
      if (this.score > this.highScore) {
        this.highScore = this.score;
        HighScoreStore.submit(this.id, this.score);
      }
      this.level += 1;
      this.audio.playStageClear();
      this._setupWave(this.level);
    }
  }

  _updateBartender(dt) {
    const bt = this.bartender;
    if (bt.pouringTimer > 0) {
      bt.pouringTimer = Math.max(0, bt.pouringTimer - dt);
    }

    // UP / DOWN teleports between the 4 bar taps
    if (this.input.isJustPressed('up')) {
      bt.barIdx = (bt.barIdx + 3) % 4;
      bt.x = this.bars[bt.barIdx].tapX;
      bt.y = this.bars[bt.barIdx].y;
      this.audio.playHop();
    } else if (this.input.isJustPressed('down')) {
      bt.barIdx = (bt.barIdx + 1) % 4;
      bt.x = this.bars[bt.barIdx].tapX;
      bt.y = this.bars[bt.barIdx].y;
      this.audio.playHop();
    }

    const bar = this.bars[bt.barIdx];

    // LEFT / RIGHT runs along the bar counter to catch empty mugs or grab tips
    const axis = this.input.getAxis();
    if (Math.abs(axis.x) > 0.1) {
      bt.x = Math.max(bar.leftX + 24, Math.min(bar.tapX, bt.x + axis.x * bt.speed * dt));
    }

    // ACTION B snaps back to the keg tap immediately
    if (this.input.isJustPressed('actionB')) {
      bt.x = bar.tapX;
      this.audio.playHop();
    }

    // ACTION A snaps to the keg tap and slides a frosty root beer mug down the counter
    if (this.input.isJustPressed('actionA') && bt.pouringTimer <= 0) {
      bt.x = bar.tapX;
      bt.pouringTimer = 0.16;
      this.mugs.push({
        barIdx: bt.barIdx,
        x: bar.rightX - 8,
        y: bar.y - 16,
        vx: -310,
        full: true
      });
      this.audio.playPump(2);
    }
  }

  _updateMugs(dt) {
    const bt = this.bartender;

    for (let i = this.mugs.length - 1; i >= 0; i--) {
      const m = this.mugs[i];
      const bar = this.bars[m.barIdx];
      m.x += m.vx * dt;

      if (m.full) {
        // Check if full mug hits an advancing thirsty patron on this bar
        let hitIndex = -1;
        let closestDist = 9999;
        for (let j = 0; j < this.patrons.length; j++) {
          const p = this.patrons[j];
          if (p.barIdx === m.barIdx && p.state !== 'drinking' && Math.abs(p.x - m.x) < 22) {
            const d = Math.abs(p.x - m.x);
            if (d < closestDist) {
              closestDist = d;
              hitIndex = j;
            }
          }
        }

        if (hitIndex !== -1) {
          const patron = this.patrons[hitIndex];
          this.mugs.splice(i, 1);
          this._servePatron(patron);
          continue;
        }

        // If full mug slides off the left end of the counter -> SMASH! Costs a life!
        if (m.x <= bar.leftX) {
          this.mugs.splice(i, 1);
          this._loseLife('MUG SMASHED OFF COUNTER!', bar.leftX, bar.y);
          return;
        }
      } else {
        // Empty mug sliding back rightward toward the bartender
        if (
          bt.barIdx === m.barIdx &&
          Math.abs(bt.x - m.x) < 28
        ) {
          this.mugs.splice(i, 1);
          this._awardPoints(100, m.x, bar.y - 26, 'CAUGHT +100', PALETTE.CYAN);
          this.audio.playCoin();
          continue;
        }

        if (m.x >= bar.tapX + 8) {
          this.mugs.splice(i, 1);
          this._loseLife('EMPTY MUG DROPPED!', bar.rightX, bar.y);
          return;
        }
      }
    }
  }

  _servePatron(patron) {
    const bar = this.bars[patron.barIdx];
    this._awardPoints(50, patron.x, bar.y - 28, '+50', PALETTE.GOLD);
    this.audio.playWaka();

    // Knock patron backward while chugging root beer
    patron.state = 'drinking';
    patron.drinkTimer = 1.05;
  }

  _updatePatrons(dt) {
    this.spawnTimer -= dt;
    if (this.spawnTimer <= 0 && this.patronsRemainingToSpawn > 0) {
      this.spawnTimer = Math.max(0.85, 2.1 - this.level * 0.12);
      const barIdx = Math.floor(Math.random() * 4);
      this._spawnPatron(barIdx);
      this.patronsRemainingToSpawn -= 1;
    }

    for (let i = this.patrons.length - 1; i >= 0; i--) {
      const p = this.patrons[i];
      const bar = this.bars[p.barIdx];

      if (p.state === 'drinking') {
        p.x -= 115 * dt;
        p.drinkTimer -= dt;

        // Knocked all the way out the left saloon door!
        if (p.x <= bar.leftX + 6) {
          this._awardPoints(100, bar.leftX + 20, bar.y - 26, 'SATISFIED +100!', PALETTE.GREEN);
          this._spawnSplash(bar.leftX + 12, bar.y - 16, PALETTE.GOLD, 12);
          this.patrons.splice(i, 1);
          continue;
        }

        // Finished drinking mid-bar -> slide empty mug back rightward and resume advancing!
        if (p.drinkTimer <= 0) {
          p.state = 'advancing';
          this.mugs.push({
            barIdx: p.barIdx,
            x: p.x + 12,
            y: bar.y - 16,
            vx: 110 + this.level * 10,
            full: false
          });

          // 35% chance to leave a green Tip Dollar Bill on the counter!
          if (Math.random() < 0.35) {
            this.tips.push({
              barIdx: p.barIdx,
              x: p.x,
              y: bar.y - 16,
              timer: 8.5
            });
          }
        }
      } else {
        // Advancing toward tap (paused if distracted by Can-Can dancers!)
        if (this.showDancerTimer > 0 && i % 2 === 0) {
          continue;
        }
        p.x += p.speed * dt;
        if (p.x >= bar.rightX - 10) {
          this._loseLife('PATRON REACHED THE TAP!', bar.rightX, bar.y);
          return;
        }
      }
    }
  }

  _updateTips(dt) {
    const bt = this.bartender;
    for (let i = this.tips.length - 1; i >= 0; i--) {
      const t = this.tips[i];
      t.timer -= dt;
      if (bt.barIdx === t.barIdx && Math.abs(bt.x - t.x) < 26) {
        this._awardPoints(500, t.x, t.y - 20, 'TIP +$500! DANCERS!', PALETTE.GREEN);
        this.audio.playPowerUp();
        this.showDancerTimer = 4.0;
        this.tips.splice(i, 1);
      } else if (t.timer <= 0) {
        this.tips.splice(i, 1);
      }
    }
  }

  _loseLife(reason, x, y) {
    this.renderer.shake(9, 0.35);
    this.audio.playExplosion(0.45, 700);
    this._spawnSplash(x, y - 14, PALETTE.RED, 24);
    this.bannerText = reason;
    this.bannerTimer = 1.8;

    this.lives -= 1;
    if (this.lives <= 0) {
      HighScoreStore.submit(this.id, this.score);
      this.audio.playGameOver();
      this.state = 'GAMEOVER';
    } else {
      // Clear mugs and push patrons back slightly so player can recover cleanly
      this.mugs = [];
      for (const p of this.patrons) {
        const bar = this.bars[p.barIdx];
        p.x = Math.max(bar.leftX + 16, p.x - 140);
        p.state = 'advancing';
      }
      this.bartender.x = this.bars[this.bartender.barIdx].tapX;
    }
  }

  _awardPoints(pts, x, y, text, color) {
    this.score += pts;
    if (this.score > this.highScore) {
      this.highScore = this.score;
      HighScoreStore.submit(this.id, this.score);
    }
    this.floatingTexts.push({
      text,
      x,
      y,
      vy: -40,
      life: 0.95,
      maxLife: 0.95,
      color
    });
  }

  _spawnSplash(x, y, color, count = 14) {
    for (let i = 0; i < count; i++) {
      const ang = (Math.PI * 2 * i) / count;
      const spd = 45 + Math.random() * 140;
      this.particles.push({
        x,
        y,
        vx: Math.cos(ang) * spd,
        vy: Math.sin(ang) * spd,
        life: 0.35 + Math.random() * 0.25,
        maxLife: 0.6,
        size: 3,
        color: i % 2 === 0 ? color : PALETTE.WHITE
      });
    }
  }

  _updateParticles(dt) {
    for (let i = this.particles.length - 1; i >= 0; i--) {
      const pt = this.particles[i];
      pt.x += pt.vx * dt;
      pt.y += pt.vy * dt;
      pt.life -= dt;
      if (pt.life <= 0) this.particles.splice(i, 1);
    }
    for (let i = this.floatingTexts.length - 1; i >= 0; i--) {
      const ft = this.floatingTexts[i];
      ft.y += ft.vy * dt;
      ft.life -= dt;
      if (ft.life <= 0) this.floatingTexts.splice(i, 1);
    }
  }

  render(ctx = this.renderer.ctx) {
    const venue = this.venue || VENUE_THEMES[0];

    // 1. Venue-Themed Flooring & Backdrop
    ctx.fillStyle = venue.bgFill;
    ctx.fillRect(0, 38, this.width, this.height - 38);

    // Venue-specific floor/backdrop pattern
    ctx.strokeStyle = venue.lineStroke;
    ctx.lineWidth = 1;
    for (let y = 60; y < this.height; y += 20) {
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(this.width, y);
      ctx.stroke();
    }
    if (venue.id === 'punk' || venue.id === 'sports' || venue.id === 'space') {
      for (let x = 80; x < this.width; x += 80) {
        ctx.beginPath();
        ctx.moveTo(x, 40);
        ctx.lineTo(x, this.height);
        ctx.stroke();
      }
    }

    // 2. Back-Wall Stage Banner (lights up when a Tip is collected!)
    ctx.fillStyle = this.showDancerTimer > 0 ? '#4C1D95' : venue.barBase;
    ctx.fillRect(260, 48, 440, 44);
    ctx.strokeStyle = this.showDancerTimer > 0 ? PALETTE.PINK : venue.barTrim;
    ctx.lineWidth = 2;
    ctx.strokeRect(260, 48, 440, 44);
    this.renderer.drawText(
      this.showDancerTimer > 0
        ? venue.dancerBanner
        : `🍺 ${this.themeName || 'ROOT BEER SALOON'} — SERVE COLD BREWS! 🍺`,
      this.width / 2,
      75,
      {
        font: FONTS.HEADER,
        size: 11,
        color: this.showDancerTimer > 0 ? PALETTE.GOLD : venue.barTrim,
        align: 'center',
        glow: this.showDancerTimer > 0 ? 10 : 4
      }
    );

    // 3. The 4 Parallel Venue Bar Counters (y = 140, 240, 340, 440)
    for (let i = 0; i < this.bars.length; i++) {
      const bar = this.bars[i];

      // Left venue entry doors / portals
      ctx.fillStyle = venue.doorFill;
      ctx.fillRect(bar.leftX - 28, bar.y - 42, 22, 54);
      ctx.strokeStyle = venue.barTrim;
      ctx.strokeRect(bar.leftX - 28, bar.y - 42, 22, 54);

      // Bar Counter Base & Top Rail
      ctx.fillStyle = venue.barBase;
      ctx.fillRect(bar.leftX, bar.y, bar.rightX - bar.leftX, 28);
      ctx.fillStyle = venue.barTop;
      ctx.fillRect(bar.leftX - 4, bar.y - 6, bar.rightX - bar.leftX + 8, 10);
      ctx.strokeStyle = venue.barTrim;
      ctx.lineWidth = 1.5;
      ctx.strokeRect(bar.leftX - 4, bar.y - 6, bar.rightX - bar.leftX + 8, 10);

      // Right-end Keg / Dispenser & Tap Handle
      ctx.fillStyle = venue.kegFill;
      ctx.fillRect(bar.rightX + 8, bar.y - 32, 38, 36);
      ctx.strokeStyle = venue.barTrim;
      ctx.lineWidth = 2;
      ctx.strokeRect(bar.rightX + 8, bar.y - 32, 38, 36);

      // Tap Lever
      ctx.strokeStyle = this.bartender.barIdx === i ? PALETTE.CYAN : PALETTE.GOLD;
      ctx.lineWidth = 4;
      ctx.beginPath();
      ctx.moveTo(bar.rightX + 14, bar.y - 26);
      ctx.lineTo(bar.rightX + 8, bar.y - 42);
      ctx.stroke();
    }

    // 4. Thirsty Patrons Advancing Along Each Bar
    for (const p of this.patrons) {
      const palette = {
        H: p.hatColor,
        F: p.skinColor || venue.skinColor,
        C: p.shirtColor,
        B: '#1E3A8A',
        K: '#0F172A'
      };
      const scale = 2.6;
      const w = SPRITES.PATRON[0].length * scale;
      const h = SPRITES.PATRON.length * scale;
      this.renderer.drawPixelSprite(
        SPRITES.PATRON,
        p.x - w / 2,
        p.y - h - 4,
        scale,
        palette
      );

      if (p.state === 'drinking') {
        this.renderer.drawPixelSprite(
          SPRITES.MUG_FULL,
          p.x + 8,
          p.y - 24,
          1.8,
          MUG_PALETTE
        );
      }
    }

    // 5. Tip Dollar Bills on Bar Counters
    for (const t of this.tips) {
      this.renderer.drawGlowRect(t.x - 9, t.y, 18, 10, PALETTE.GREEN, 8);
      this.renderer.drawText('$', t.x, t.y + 9, {
        font: FONTS.HEADER,
        size: 8,
        color: PALETTE.WHITE,
        align: 'center'
      });
    }

    // 6. Sliding Full & Empty Root Beer Mugs
    for (const m of this.mugs) {
      const sprite = m.full ? SPRITES.MUG_FULL : SPRITES.MUG_EMPTY;
      const scale = 2.1;
      const w = sprite[0].length * scale;
      const h = sprite.length * scale;
      this.renderer.drawPixelSprite(sprite, m.x - w / 2, m.y - h / 2, scale, MUG_PALETTE);
    }

    // 7. Bartender
    const bt = this.bartender;
    const btScale = 2.7;
    const bw = SPRITES.BARTENDER[0].length * btScale;
    const bh = SPRITES.BARTENDER.length * btScale;
    this.renderer.drawPixelSprite(
      SPRITES.BARTENDER,
      bt.x - bw / 2,
      bt.y - bh - 4,
      btScale,
      BARTENDER_PALETTE
    );

    // 8. Particles & Floating Score Popups
    for (const pt of this.particles) {
      ctx.fillStyle = pt.color;
      ctx.fillRect(pt.x - pt.size / 2, pt.y - pt.size / 2, pt.size, pt.size);
    }

    for (const ft of this.floatingTexts) {
      this.renderer.drawText(ft.text, ft.x, ft.y, {
        font: FONTS.HEADER,
        size: 11,
        color: ft.color,
        align: 'center',
        glow: 8
      });
    }

    if (this.bannerTimer > 0 && this.state === 'PLAYING') {
      this.renderer.drawText(this.bannerText, this.width / 2, 275, {
        font: FONTS.HEADER,
        size: 15,
        color: PALETTE.GOLD,
        align: 'center',
        glow: 12
      });
    }

    this.renderer.drawHUD({
      title: this.title,
      score: this.score,
      highScore: this.highScore,
      lives: this.lives,
      level: this.level,
      extraLabel: `PATRONS: ${this.patrons.length + this.patronsRemainingToSpawn}`,
      accent: PALETTE.ORANGE
    });

    this.renderer.drawStateOverlay(this.state, {
      title: this.title,
      subtitle: '4-BAR ROOT BEER SALOON EDITION',
      controls: 'UP/DOWN: SWITCH BAR  |  SPACE/Z: POUR & SLIDE MUG  |  LEFT/RIGHT: CATCH MUGS & TIPS',
      score: this.score,
      highScore: this.highScore,
      accent: PALETTE.ORANGE
    });
  }
}



// === native frame loop (mirrors src/main.js) ===
// Sprite blitting: identical per-cell rects, issued from C in one call instead of one JS call per cell.
Renderer.prototype.drawPixelSprite = function (rows, x, y, scale = 2, palette = {}, flipX = false, flipY = false) {
  __nc.sprite(rows, x, y, scale, palette, flipX, flipY);
};
const __renderer = new Renderer(null, null);
const __input = new InputManager(null);
const __audio = new AudioSynth();
const __game = new Tapper(__renderer, __input, __audio);
function __frame() {
  const dt = 1 / 60;
  __input.pollGamepads();
  __input.updateTurbo(dt);
  __renderer.beginFrame(dt);
  __game.update(dt);
  __game.render(__renderer.ctx);
  __renderer.endFrame();
  __input.endFrame();
}
