    let down = false;
    let left = false;
    let right = false;
    let actionA = false;
    let actionB = false;
    let pause = false;
    let menu = false;
    let select = false;
    let start = false;
    let l1 = false;
    let r1 = false;
    let l2 = false;
    let r2 = false;
    let l3 = false;
    let r3 = false;
    let saveState = false;
    let loadState = false;
    let fastForward = false;
    let favorite = false;
    let nextTab = false;
    let prevTab = false;
    let rewindHeld = false;
