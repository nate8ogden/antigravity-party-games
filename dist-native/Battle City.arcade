/**
 * Renderer.js
 * Core 16:9 Scalable Viewport & 2D-to-WebGL Framebuffer Renderer for Retro Arcade Studio.
 * Coordinates offscreen 2D canvas drawing, particle/shake effects, pixel-art sprite matrices,
 * HighScore LocalStorage + Firebase Cloud Sync persistence, 3-Initial Champion Entry,
 * Rewind VHS overlay, Achievement Toasts, and the WebGL CRT Post-Processing pipeline.
 */
const PALETTE = {
  BG: '#0B0F19',     // Deep space background
  CYAN: '#00F0FF',   // Electric Cyan
  PINK: '#FF007A',   // Neon Pink
  GOLD: '#FFD700',   // Arcade Gold
  GREEN: '#00FF66',  // Vivid Green
  ORANGE: '#FF8800',
  PURPLE: '#B829FF',
  RED: '#FF2A55',
  BLUE: '#38BDF8',
  WHITE: '#F8FAFC',
  MUTED: '#94A3B8',
  PANEL: '#131B2E'
};
const FONTS = {
  HEADER: "'Press Start 2P', 'Courier New', monospace",
  HUD: "'Space Grotesk', system-ui, -apple-system, sans-serif",
  BODY: "'Inter', system-ui, -apple-system, sans-serif"
};

const HIGHSCORE_STORAGE_KEY = 'retro_arcade_studio_highscores_v1';
const HOLDERS_STORAGE_KEY = 'retro_arcade_studio_holders_v1';

const DEFAULT_HIGHSCORES = {
  loderunner: 12500,
  digdug: 18400,
  donkeykong: 22000,
  sumo: 9500,
  pacman: 25600,
  frogger: 14200,
  galaga: 30000,
  spaceinvaders: 16500,
  asteroids: 15000,
  centipede: 14000,
  defender: 19500,
  arkanoid: 17000,
  paperboy: 11000,
  joust: 13500,
  qbert: 12800,
  rampage: 16000,
  marblemadness: 14500,
  pitfall: 15400,
  duckhunt: 12000,
  excitebike: 13200,
  missilecommand: 14800,
  burgertime: 13600,
  bubblebobble: 16800,
  spyhunter: 15200,
  tron: 11800,
  trackandfield: 10500,
  outrun: 24000,
  contra: 21000,
  galaxian: 14200,
  digdug2: 15800,
  elevatoraction: 16500,
  tapper: 13900,
  lunarlander: 11500,
  tempest: 22400,
  robotron: 28000,
  sinistar: 25600,
  crystalcastles: 17200,
  zaxxon: 19400,
  moonpatrol: 14600,
  pengo: 15200,
  rallyx: 13800,
  roadfighter: 16400,
  flicky: 14900,
  game1942: 19420,
  circuscharlie: 13400,
  battlecity: 18200,
  kungfumaster: 19800,
  wildgunman: 12600,
  exerion: 15100,
  tetrisretro: 24500
};
class HighScoreStore {
  static loadAll() {
    if (HighScoreStore._scoresCache) {
      return HighScoreStore._scoresCache;
    }
    try {
      const raw = localStorage.getItem(HIGHSCORE_STORAGE_KEY);
      let scores;
      if (!raw) {
        localStorage.setItem(HIGHSCORE_STORAGE_KEY, JSON.stringify(DEFAULT_HIGHSCORES));
        scores = { ...DEFAULT_HIGHSCORES };
      } else {
        const parsed = JSON.parse(raw);
        scores = { ...DEFAULT_HIGHSCORES, ...parsed };
      }
      // Merge with Firebase Cloud Persistence records
      for (const id of Object.keys(scores)) {
        const cloudRec = cloudPersistence.getRecord(id);
        if (cloudRec.highScore > scores[id]) {
          scores[id] = cloudRec.highScore;
        } else if (scores[id] > cloudRec.highScore) {
          cloudRec.highScore = scores[id];
        }
      }
      HighScoreStore._scoresCache = scores;
      return scores;
    } catch (_) {
      HighScoreStore._scoresCache = { ...DEFAULT_HIGHSCORES };
      return HighScoreStore._scoresCache;
    }
  }

  static get(gameId) {
    const key = String(gameId || '').toLowerCase();
    const all = HighScoreStore.loadAll();
    const cloudRec = cloudPersistence.getRecord(key);
    return Math.max(all[key] || 5000, cloudRec.highScore || 0);
  }

  static getHolder(gameId) {
    const key = String(gameId || '').toLowerCase();
    if (!HighScoreStore._holdersCache) {
      try {
        const raw = localStorage.getItem(HOLDERS_STORAGE_KEY);
        HighScoreStore._holdersCache = raw ? JSON.parse(raw) || {} : {};
      } catch (_) {
        HighScoreStore._holdersCache = {};
      }
    }
    if (HighScoreStore._holdersCache[key]) {
      return HighScoreStore._holdersCache[key];
    }
    const cloudRec = cloudPersistence.getRecord(key);
    return cloudRec.holder || 'ACE';
  }

  static setHolder(gameId, initials) {
    const key = String(gameId || '').toLowerCase();
    const clean = InitialsStore.setLastInitials(initials);
    if (!HighScoreStore._holdersCache) {
      HighScoreStore.getHolder(key);
    }
    HighScoreStore._holdersCache[key] = clean;
    try {
      localStorage.setItem(HOLDERS_STORAGE_KEY, JSON.stringify(HighScoreStore._holdersCache));
    } catch (_) {}
    const cloudRec = cloudPersistence.getRecord(key);
    cloudRec.holder = clean;
    cloudPersistence.saveToLocal();
    return clean;
  }

  static submit(gameId, score, holderInitials = null) {
    const key = String(gameId || '').toLowerCase();
    const numeric = Math.floor(Number(score) || 0);
    const all = HighScoreStore.loadAll();
    const prev = all[key] || 0;
    const isNew = numeric > prev;
    const initials = holderInitials || InitialsStore.getLastInitials();
    if (isNew) {
      all[key] = numeric;
      try {
        localStorage.setItem(HIGHSCORE_STORAGE_KEY, JSON.stringify(all));
      } catch (_) {}
      HighScoreStore.setHolder(key, initials);
    }
    // Sync to Firebase Cloud Persistence
    cloudPersistence.recordScore(key, Math.max(prev, numeric), isNew ? initials : null);
    if (numeric >= 25000) {
      achievementManager.unlock('high_roller');
    }
    return { highScore: Math.max(prev, numeric), isNew };
  }
}
class Renderer {
  constructor(displayCanvas, viewportContainer = null) {
    this.width = 960;
    this.height = 540;
    this.displayCanvas = displayCanvas;
    this.viewportContainer =
      viewportContainer || (displayCanvas ? displayCanvas.parentElement : null);

    // Offscreen 2D framebuffer where all games draw
    this.bufferCanvas = document.createElement('canvas');
    this.bufferCanvas.width = this.width;
    this.bufferCanvas.height = this.height;
    this.ctx = this.bufferCanvas.getContext('2d');
    this.ctx.imageSmoothingEnabled = false;

    if (this.displayCanvas) {
      this.displayCanvas.width = this.width;
      this.displayCanvas.height = this.height;
    }

    // Wrap the display canvas in the WebGL CRT post-processing shader pipeline
    this.crt = new CRTOverlay(this.displayCanvas, this.bufferCanvas);
    this.wasm = wasmCore;

    this.shakeTime = 0;
    this.shakeIntensity = 0;
    this.flashAlpha = 0;
    this.rewinding = false;
    this.attractMode = false;
    this.timeScale = 1.0;

    // 3-Initial Champion Entry State on Game Over
    this.initialsChars = InitialsStore.getLastInitials().split('');
    this.initialsCursor = 0;

    this.resizeViewport();
    this._onResize = () => this.resizeViewport();
    window.addEventListener('resize', this._onResize);
    window.addEventListener('orientationchange', this._onResize);
  }

  /**
   * Responsive 16:9 viewport scaling across Desktop, Tablet, and Mobile Phone (Portrait & Landscape)
   */
  resizeViewport() {
    if (!this.displayCanvas || !this.viewportContainer) return;
    const rect = this.viewportContainer.getBoundingClientRect();
    this._lastVpW = rect.width || window.innerWidth || 960;
    this._lastVpH = rect.height || window.innerHeight || 540;
    const touchEl =
      typeof document !== 'undefined' ? document.getElementById('arcade-touch-overlay') : null;
    const touchVisible = !!(touchEl && touchEl.classList.contains('visible'));
    const winW = window.innerWidth || rect.width || 960;
    const winH = window.innerHeight || rect.height || 540;
    const isPortrait = winH >= winW;
    const isPhoneLandscape = !isPortrait && winH <= 520 && touchVisible;

    let reservedSides = 0;
    if (isPhoneLandscape) {
      // In compact phone landscape, D-Pad and Action A/B sit in left/right gutters
      reservedSides = Math.min(240, Math.max(170, winW * 0.25));
    }

    // Note: CSS padding-bottom on .arcade-viewport already reserves bottom touch space when needed,
    // so we measure the inner content box of .arcade-viewport directly to avoid double-subtracting!
    const style =
      typeof window !== 'undefined' && window.getComputedStyle
        ? window.getComputedStyle(this.viewportContainer)
        : null;
    const padTop = style ? parseFloat(style.paddingTop) || 0 : 6;
    const padBot = style ? parseFloat(style.paddingBottom) || 0 : 6;
    const padLeft = style ? parseFloat(style.paddingLeft) || 0 : 6;
    const padRight = style ? parseFloat(style.paddingRight) || 0 : 6;

    const rawW = rect.width > 40 ? rect.width : winW;
    const rawH = rect.height > 40 ? rect.height : Math.max(240, winH - 90);
    const availW = Math.max(200, rawW - padLeft - padRight - reservedSides - 6);
    const availH = Math.max(120, rawH - padTop - padBot - 6);
    const targetAspect = 16 / 9;

    let drawW = availW;
    let drawH = drawW / targetAspect;
    if (drawH > availH) {
      drawH = availH;
      drawW = drawH * targetAspect;
    }

    this.displayCanvas.style.width = `${Math.floor(drawW)}px`;
    this.displayCanvas.style.height = `${Math.floor(drawH)}px`;
  }

  shake(intensity = 6, duration = 0.2) {
    this.shakeIntensity = Math.max(this.shakeIntensity, intensity);
    this.shakeTime = Math.max(this.shakeTime, duration);
  }

  triggerFlash(alpha = 0.85) {
    this.flashAlpha = alpha;
  }

  beginFrame(dt = 0.016) {
    this._frameTick = ((this._frameTick || 0) + 1) % 30;
    if (this._frameTick === 0 && this.viewportContainer) {
      const cw = this.viewportContainer.clientWidth || 0;
      const ch = this.viewportContainer.clientHeight || 0;
      if (cw > 40 && ch > 40 && (Math.abs(cw - (this._lastVpW || 0)) > 4 || Math.abs(ch - (this._lastVpH || 0)) > 4)) {
        this.resizeViewport();
      }
    }
    const ctx = this.ctx;
    ctx.save();
    ctx.fillStyle = PALETTE.BG;
    ctx.fillRect(0, 0, this.width, this.height);

    if (this.shakeTime > 0) {
      this.shakeTime = Math.max(0, this.shakeTime - dt);
      const ox = (Math.random() * 2 - 1) * this.shakeIntensity;
      const oy = (Math.random() * 2 - 1) * this.shakeIntensity;
      ctx.translate(ox, oy);
      if (this.shakeTime <= 0) {
        this.shakeIntensity = 0;
      }
    }

    if (this.flashAlpha > 0) {
      this.flashAlpha = Math.max(0, this.flashAlpha - dt * 2.8);
    }

    achievementManager.update(dt);
  }

  endFrame() {
    const ctx = this.ctx;
    ctx.restore();

    // 1. Rewind Time-Machine VHS Scan Bar Overlay
    if (this.rewinding || (this.rewindOverlay && this.rewindOverlay.active)) {
      ctx.save();
      ctx.fillStyle = 'rgba(0, 240, 255, 0.14)';
      ctx.fillRect(0, 0, this.width, this.height);
      const barY = ((performance.now() * 0.45) % this.height);
      ctx.fillStyle = 'rgba(255, 255, 255, 0.22)';
      ctx.fillRect(0, barY, this.width, 18);
      this.drawText('⏪ REWINDING TIME-MACHINE', this.width / 2, 74, {
        font: FONTS.HEADER,
        size: 16,
        color: PALETTE.CYAN,
        align: 'center',
        glow: 14
      });
      ctx.restore();
    }

    // 2. Attract Mode Demo Banner
    if (this.attractMode || (this.attractOverlay && this.attractOverlay.active)) {
      const blink = Math.floor(performance.now() / 420) % 2 === 0;
      ctx.save();
      ctx.fillStyle = 'rgba(11, 15, 25, 0.82)';
      ctx.strokeStyle = PALETTE.GOLD;
      ctx.lineWidth = 2;
      ctx.fillRect(190, 488, 580, 36);
      ctx.strokeRect(190, 488, 580, 36);
      if (blink) {
        this.drawText(
          '🎬 ATTRACT DEMO MODE — PRESS ANY KEY OR TAP TO INSERT COIN',
          this.width / 2,
          511,
          {
            font: FONTS.HEADER,
            size: 10.5,
            color: PALETTE.GOLD,
            align: 'center',
            glow: 10
          }
        );
      }
      ctx.restore();
    }

    // 3. Achievement & Emulator Save State Toast Notifications
    if (achievementManager.activeToasts.length > 0) {
      ctx.save();
      achievementManager.activeToasts.forEach((t, idx) => {
        const y = 46 + idx * 52;
        const x = this.width - 332;
        ctx.fillStyle = 'rgba(15, 23, 42, 0.95)';
        ctx.strokeStyle = t.color || PALETTE.GOLD;
        ctx.lineWidth = 2;
        ctx.shadowColor = t.color || PALETTE.GOLD;
        ctx.shadowBlur = 12;
        ctx.fillRect(x, y, 320, 44);
        ctx.strokeRect(x, y, 320, 44);
        ctx.shadowBlur = 0;

        this.drawText(t.title, x + 12, y + 19, {
          font: FONTS.HEADER,
          size: 9.5,
          color: t.color || PALETTE.GOLD
        });
        if (t.subtitle) {
          this.drawText(t.subtitle, x + 12, y + 36, {
            font: FONTS.BODY,
            size: 11,
            color: PALETTE.WHITE,
            bold: false
          });
        }
      });
      ctx.restore();
    }

    // 4. Screenshot Shutter Flash
    if (this.flashAlpha > 0) {
      ctx.save();
      ctx.fillStyle = `rgba(255, 255, 255, ${this.flashAlpha.toFixed(2)})`;
      ctx.fillRect(0, 0, this.width, this.height);
      ctx.restore();
    }

    this.crt.render();
  }

  clear(color = PALETTE.BG) {
    this.ctx.fillStyle = color;
    this.ctx.fillRect(0, 0, this.width, this.height);
  }

  drawGlowRect(x, y, w, h, color, _blur = 10, fill = true, lineWidth = 2) {
    const ctx = this.ctx;
    if (fill) {
      ctx.fillStyle = color;
      ctx.fillRect(x, y, w, h);
    } else {
      ctx.strokeStyle = color;
      ctx.lineWidth = lineWidth;
      ctx.strokeRect(x, y, w, h);
    }
  }

  drawGlowCircle(x, y, r, color, _blur = 10, fill = true, lineWidth = 2) {
    const ctx = this.ctx;
    ctx.beginPath();
    ctx.arc(x, y, Math.max(0.5, r), 0, Math.PI * 2);
    if (fill) {
      ctx.fillStyle = color;
      ctx.fill();
    } else {
      ctx.strokeStyle = color;
      ctx.lineWidth = lineWidth;
      ctx.stroke();
    }
  }

  drawText(
    text,
    x,
    y,
    {
      font = FONTS.HUD,
      size = 16,
      color = PALETTE.WHITE,
      align = 'left',
      baseline = 'alphabetic',
      bold = true
    } = {}
  ) {
    const ctx = this.ctx;
    ctx.font = `${bold ? '700 ' : ''}${size}px ${font}`;
    ctx.fillStyle = color;
    ctx.textAlign = align;
    ctx.textBaseline = baseline;
    ctx.fillText(String(text), x, y);
  }

  /**
   * Renders a pixel art matrix where each character in strings maps to a hex color
   */
  drawPixelSprite(rows, x, y, scale = 2, palette = {}, flipX = false, flipY = false) {
    const ctx = this.ctx;
    const h = rows.length;
    const w = rows[0] ? rows[0].length : 0;
    for (let r = 0; r < h; r++) {
      const rowStr = rows[r];
      for (let c = 0; c < w; c++) {
        const ch = rowStr[c];
        if (ch === '.' || ch === ' ' || !palette[ch]) continue;
        const drawC = flipX ? w - 1 - c : c;
        const drawR = flipY ? h - 1 - r : r;
        ctx.fillStyle = palette[ch];
        ctx.fillRect(
          Math.round(x + drawC * scale),
          Math.round(y + drawR * scale),
          Math.ceil(scale),
          Math.ceil(scale)
        );
      }
    }
  }

  /**
   * Draws a game-specific miniature pixel-art life icon in the arcade HUD
   */
  _drawLifeIcon(ctx, titleUpper, x, y, accent = PALETTE.CYAN) {
    ctx.save();
    if (titleUpper.includes('PAC')) {
      // Classic yellow Pac-Man profile wedge facing left
      ctx.fillStyle = PALETTE.GOLD;
      ctx.beginPath();
      ctx.arc(x + 6, y + 6, 5.5, 1.25 * Math.PI, 0.75 * Math.PI, false);
      ctx.lineTo(x + 6, y + 6);
      ctx.closePath();
      ctx.fill();
    } else if (
      titleUpper.includes('GALAGA') ||
      titleUpper.includes('GALAXIAN') ||
      titleUpper.includes('DEFENDER') ||
      titleUpper.includes('SINISTAR') ||
      titleUpper.includes('EXERION') ||
      titleUpper.includes('ZAXXON') ||
      titleUpper.includes('STAR') ||
      titleUpper.includes('HORIZON') ||
      titleUpper.includes('INERTIA')
    ) {
      // Classic white/red Namco starfighter icon
      ctx.fillStyle = PALETTE.WHITE;
      ctx.fillRect(x + 5, y + 1, 2, 10);
      ctx.fillRect(x + 3, y + 4, 6, 5);
      ctx.fillRect(x + 1, y + 6, 10, 4);
      ctx.fillStyle = PALETTE.RED;
      ctx.fillRect(x + 1, y + 5, 2, 2);
      ctx.fillRect(x + 9, y + 5, 2, 2);
      ctx.fillRect(x + 5, y + 4, 2, 3);
    } else if (titleUpper.includes('INVADER') || titleUpper.includes('ARMADA')) {
      // Classic Taito green laser cannon base
      ctx.fillStyle = PALETTE.GREEN;
      ctx.fillRect(x + 5, y + 2, 2, 3);
      ctx.fillRect(x + 3, y + 5, 6, 2);
      ctx.fillRect(x + 1, y + 7, 10, 4);
    } else if (titleUpper.includes('FROG') || titleUpper.includes('HOPPER')) {
      // Mini green frog with yellow eyes
      ctx.fillStyle = PALETTE.GREEN;
      ctx.fillRect(x + 3, y + 3, 6, 7);
      ctx.fillRect(x + 1, y + 2, 2, 3);
      ctx.fillRect(x + 9, y + 2, 2, 3);
      ctx.fillRect(x + 1, y + 8, 2, 3);
      ctx.fillRect(x + 9, y + 8, 2, 3);
      ctx.fillStyle = PALETTE.GOLD;
      ctx.fillRect(x + 3, y + 2, 2, 2);
      ctx.fillRect(x + 7, y + 2, 2, 2);
    } else if (titleUpper.includes('DIG') || titleUpper.includes('DRILLER')) {
      // Mini Taizo Hori white/blue helmet
      ctx.fillStyle = PALETTE.WHITE;
      ctx.fillRect(x + 2, y + 1, 8, 9);
      ctx.fillStyle = PALETTE.CYAN;
      ctx.fillRect(x + 3, y + 3, 6, 3);
      ctx.fillStyle = PALETTE.RED;
      ctx.fillRect(x + 3, y + 9, 6, 2);
    } else if (
      titleUpper.includes('KONG') ||
      titleUpper.includes('GIRDER') ||
      titleUpper.includes('LODE') ||
      titleUpper.includes('VAULT') ||
      titleUpper.includes('PITFALL') ||
      titleUpper.includes('CONTRA') ||
      titleUpper.includes('COMMANDO') ||
      titleUpper.includes('KUNG')
    ) {
      // Mini Jumpman / Hero cap & face
      ctx.fillStyle = PALETTE.RED;
      ctx.fillRect(x + 2, y + 1, 8, 3);
      ctx.fillRect(x + 4, y + 3, 7, 2);
      ctx.fillStyle = '#FDE68A';
      ctx.fillRect(x + 3, y + 5, 6, 4);
      ctx.fillStyle = PALETTE.BLUE;
      ctx.fillRect(x + 3, y + 9, 6, 3);
    } else if (
      titleUpper.includes('ASTEROID') ||
      titleUpper.includes('METEOR') ||
      titleUpper.includes('LANDER') ||
      titleUpper.includes('TEMPEST') ||
      titleUpper.includes('VORTEX')
    ) {
      // Glowing vector A-frame ship
      ctx.strokeStyle = accent || PALETTE.CYAN;
      ctx.lineWidth = 1.6;
      ctx.beginPath();
      ctx.moveTo(x + 6, y + 1);
      ctx.lineTo(x + 11, y + 11);
      ctx.lineTo(x + 8, y + 9);
      ctx.lineTo(x + 4, y + 9);
      ctx.lineTo(x + 1, y + 11);
      ctx.closePath();
      ctx.stroke();
    } else if (
      titleUpper.includes('OUTRUN') ||
      titleUpper.includes('SPY') ||
      titleUpper.includes('HIGHWAY') ||
      titleUpper.includes('RALLY') ||
      titleUpper.includes('ROAD') ||
      titleUpper.includes('TRON') ||
      titleUpper.includes('LIGHT')
    ) {
      // Mini top-down race car
      ctx.fillStyle = PALETTE.RED;
      ctx.fillRect(x + 3, y + 1, 6, 10);
      ctx.fillStyle = PALETTE.CYAN;
      ctx.fillRect(x + 4, y + 3, 4, 3);
      ctx.fillStyle = PALETTE.WHITE;
      ctx.fillRect(x + 1, y + 2, 2, 3);
      ctx.fillRect(x + 9, y + 2, 2, 3);
      ctx.fillRect(x + 1, y + 7, 2, 3);
      ctx.fillRect(x + 9, y + 7, 2, 3);
    } else if (titleUpper.includes('BATTLE') || titleUpper.includes('TANK')) {
      // Mini golden tank
      ctx.fillStyle = PALETTE.GOLD;
      ctx.fillRect(x + 1, y + 3, 2, 8);
      ctx.fillRect(x + 9, y + 3, 2, 8);
      ctx.fillRect(x + 3, y + 4, 6, 6);
      ctx.fillRect(x + 5, y + 1, 2, 4);
    } else if (titleUpper.includes('Q*BERT') || titleUpper.includes('ISO HOP')) {
      // Mini orange Q*bert head & snout
      ctx.fillStyle = PALETTE.ORANGE;
      ctx.beginPath();
      ctx.arc(x + 5, y + 6, 4.5, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillRect(x + 7, y + 5, 4, 3);
      ctx.fillStyle = PALETTE.WHITE;
      ctx.fillRect(x + 3, y + 3, 3, 3);
    } else if (titleUpper.includes('BUBBLE')) {
      // Mini green Bub dragon
      ctx.fillStyle = PALETTE.GREEN;
      ctx.fillRect(x + 2, y + 2, 8, 8);
      ctx.fillStyle = PALETTE.GOLD;
      ctx.fillRect(x + 1, y + 3, 2, 5);
      ctx.fillStyle = PALETTE.WHITE;
      ctx.fillRect(x + 6, y + 3, 3, 3);
    } else if (titleUpper.includes('BURGER') || titleUpper.includes('BISTRO')) {
      // Mini white Chef hat
      ctx.fillStyle = PALETTE.WHITE;
      ctx.fillRect(x + 2, y + 1, 8, 5);
      ctx.fillRect(x + 3, y + 6, 6, 3);
      ctx.fillStyle = '#FDBA74';
      ctx.fillRect(x + 3, y + 9, 6, 3);
    } else {
      // Classic arcade heart / badge icon
      ctx.fillStyle = accent || PALETTE.PINK;
      ctx.fillRect(x + 2, y + 2, 3, 3);
      ctx.fillRect(x + 7, y + 2, 3, 3);
      ctx.fillRect(x + 1, y + 4, 10, 4);
      ctx.fillRect(x + 3, y + 8, 6, 2);
      ctx.fillRect(x + 5, y + 10, 2, 2);
    }
    ctx.restore();
  }

  /**
   * Draws classic Namco/Taito style stage pennant flags next to the stage counter
   */
  _drawStageFlags(ctx, level, x, y) {
    ctx.save();
    const tens = Math.min(3, Math.floor(level / 10));
    const ones = Math.min(4, level % 10);
    let curX = x;
    for (let i = 0; i < tens; i++) {
      // Large Red/Gold 10-Stage Pennant
      ctx.fillStyle = PALETTE.WHITE;
      ctx.fillRect(curX, y, 1.5, 13);
      ctx.fillStyle = PALETTE.RED;
      ctx.beginPath();
      ctx.moveTo(curX + 1.5, y);
      ctx.lineTo(curX + 9, y + 4);
      ctx.lineTo(curX + 1.5, y + 8);
      ctx.closePath();
      ctx.fill();
      ctx.fillStyle = PALETTE.GOLD;
      ctx.fillRect(curX + 2, y + 3, 4, 2);
      curX += 10;
    }
    for (let i = 0; i < ones; i++) {
      // Classic Yellow/Red 1-Stage Pennant
      ctx.fillStyle = PALETTE.WHITE;
      ctx.fillRect(curX, y + 1, 1.5, 12);
      ctx.fillStyle = PALETTE.GOLD;
      ctx.beginPath();
      ctx.moveTo(curX + 1.5, y + 1);
      ctx.lineTo(curX + 7, y + 4);
      ctx.lineTo(curX + 1.5, y + 7);
      ctx.closePath();
      ctx.fill();
      curX += 7;
    }
    ctx.restore();
  }

  /**
   * Draws an authentic 1980s coin-op top arcade HUD bar (38px height)
   */
  drawHUD({
    title = 'ARCADE',
    score = 0,
    highScore = 0,
    lives = 3,
    level = 1,
    extraLabel = '',
    accent = PALETTE.CYAN
  } = {}) {
    const ctx = this.ctx;
    const titleUpper = String(title || 'ARCADE').toUpperCase();
    ctx.save();

    // Pitch-black coin-op marquee header strip with double neon trim
    ctx.fillStyle = '#04060C';
    ctx.fillRect(0, 0, this.width, 38);
    ctx.strokeStyle = accent;
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(0, 36.5);
    ctx.lineTo(this.width, 36.5);
    ctx.stroke();
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.16)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(0, 34);
    ctx.lineTo(this.width, 34);
    ctx.stroke();

    // 1. Classic Arcade Marquee Title (left)
    const displayTitle = titleUpper.length > 16 ? titleUpper.slice(0, 16) : titleUpper;
    this.drawText(displayTitle, 12, 23, {
      font: FONTS.HEADER,
      size: displayTitle.length > 13 ? 10 : 11.5,
      color: accent,
      glow: 8
    });

    // 2. Classic Coin-Op 1UP Header + 6-Digit Bitmap Score
    const blink1UP = Math.floor(performance.now() / 360) % 2 === 0;
    this.drawText('1UP', 238, 13, {
      font: FONTS.HEADER,
      size: 7.5,
      color: blink1UP ? PALETTE.RED : PALETTE.WHITE
    });
    this.drawText(String(Math.floor(score)).padStart(6, '0'), 238, 28, {
      font: FONTS.HEADER,
      size: 11,
      color: PALETTE.WHITE
    });

    // 3. HIGH SCORE + Champion Initials in Arcade Gold
    const holder = InitialsStore.getLastInitials();
    this.drawText(`HIGH SCORE (${holder})`, 365, 13, {
      font: FONTS.HEADER,
      size: 7.5,
      color: PALETTE.GOLD
    });
    this.drawText(
      String(Math.floor(Math.max(score, highScore))).padStart(6, '0'),
      365,
      28,
      {
        font: FONTS.HEADER,
        size: 11,
        color: PALETTE.GOLD,
        glow: 6
      }
    );

    // 4. Stage Counter + Classic Arcade Stage Pennant Flags
    this.drawText(`RD:${String(level).padStart(2, '0')}`, 542, 24, {
      font: FONTS.HEADER,
      size: 9.5,
      color: PALETTE.GREEN
    });
    this._drawStageFlags(ctx, level, 600, 12);

    // 5. Game-specific status telemetry (e.g. GOLD, BONUS, BAYS, FUEL)
    if (extraLabel) {
      const cleanExtra = String(extraLabel).length > 22 ? String(extraLabel).slice(0, 22) : extraLabel;
      this.drawText(cleanExtra, 642, 24, {
        font: FONTS.HEADER,
        size: 8,
        color: PALETTE.CYAN
      });
    }

    // 6. Game-Specific Pixel-Art Life Icons on far right
    const maxLivesIcons = Math.max(0, Math.min(6, lives));
    for (let i = 0; i < maxLivesIcons; i++) {
      this._drawLifeIcon(ctx, titleUpper, 864 + i * 15, 12, accent);
    }
    ctx.restore();
  }

  /**
   * Authentic 1980s Coin-Op Attract / Pause / Game Over Cabinet Overlay
   */
  drawStateOverlay(
    state,
    {
      title = '',
      subtitle = '',
      controls = 'ARROWS/WASD: MOVE  |  Z/SPACE: ACTION A  |  X/SHIFT: ACTION B  |  P: PAUSE',
      score = 0,
      highScore = 0,
      accent = PALETTE.CYAN
    } = {}
  ) {
    if (state === 'PLAYING') return;
    const ctx = this.ctx;
    ctx.save();
    ctx.fillStyle = 'rgba(4, 6, 12, 0.84)';
    ctx.fillRect(0, 38, this.width, this.height - 38);

    const boxW = 660;
    const boxH = 304;
    const bx = (this.width - boxW) / 2;
    const by = (this.height - boxH) / 2 + 12;
    const frameCol = state === 'GAMEOVER' ? PALETTE.PINK : accent;

    // Outer & inner double-line coin-op cabinet frame
    ctx.fillStyle = 'rgba(10, 15, 28, 0.97)';
    ctx.fillRect(bx, by, boxW, boxH);
    ctx.strokeStyle = frameCol;
    ctx.lineWidth = 3;
    ctx.shadowColor = frameCol;
    ctx.shadowBlur = 16;
    ctx.strokeRect(bx, by, boxW, boxH);
    ctx.shadowBlur = 0;

    ctx.strokeStyle = PALETTE.GOLD;
    ctx.lineWidth = 1.2;
    ctx.strokeRect(bx + 6, by + 6, boxW - 12, boxH - 12);

    // Corner arcade rivets
    ctx.fillStyle = PALETTE.GOLD;
    for (const [rx, ry] of [
      [bx + 10, by + 10],
      [bx + boxW - 14, by + 10],
      [bx + 10, by + boxH - 14],
      [bx + boxW - 14, by + boxH - 14]
    ]) {
      ctx.fillRect(rx, ry, 4, 4);
    }

    const pulse = 0.65 + 0.35 * Math.sin(performance.now() * 0.006);
    const blinkCoin = Math.floor(performance.now() / 420) % 2 === 0;

    if (state === 'MENU') {
      this.drawText(title.toUpperCase(), this.width / 2, by + 56, {
        font: FONTS.HEADER,
        size: 22,
        color: accent,
        align: 'center',
        glow: 12
      });
      this.drawText(subtitle || 'AUTHENTIC COIN-OP ARCADE EDITION', this.width / 2, by + 90, {
        font: FONTS.HEADER,
        size: 10,
        color: PALETTE.GOLD,
        align: 'center'
      });
      this.drawText(controls, this.width / 2, by + 138, {
        font: FONTS.HUD,
        size: 13,
        color: PALETTE.WHITE,
        align: 'center'
      });
      ctx.globalAlpha = pulse;
      this.drawText(
        blinkCoin
          ? 'INSERT COIN  •  PRESS [SPACE / Z / TAP] FOR 1P START'
          : 'PUSH 1P START BUTTON [SPACE / Z / TAP]',
        this.width / 2,
        by + 196,
        {
          font: FONTS.HEADER,
          size: 12,
          color: PALETTE.GREEN,
          align: 'center',
          glow: 10
        }
      );
      ctx.globalAlpha = 1;
      this.drawText(
        `TOP SCORE: ${String(highScore).padStart(6, '0')} (${InitialsStore.getLastInitials()})   •   CREDIT 01 (FREE PLAY)`,
        this.width / 2,
        by + 242,
        {
          font: FONTS.HEADER,
          size: 9.5,
          color: PALETTE.GOLD,
          align: 'center'
        }
      );
      this.drawText('© 1978-1989 RETRO ARCADE STUDIO ARCHIVE', this.width / 2, by + 276, {
        font: FONTS.HEADER,
        size: 8,
        color: PALETTE.MUTED,
        align: 'center'
      });
    } else if (state === 'PAUSED') {
      this.drawText('PAUSE / DIP SWITCHES', this.width / 2, by + 60, {
        font: FONTS.HEADER,
        size: 20,
        color: PALETTE.GOLD,
        align: 'center',
        glow: 12
      });
      this.drawText(controls, this.width / 2, by + 114, {
        font: FONTS.HUD,
        size: 13,
        color: PALETTE.WHITE,
        align: 'center'
      });
      this.drawText(
        '[F5] SAVE STATE  |  [F8] LOAD STATE  |  [.] FRAME STEP  |  [R] REWIND',
        this.width / 2,
        by + 156,
        {
          font: FONTS.HEADER,
          size: 9,
          color: PALETTE.GOLD,
          align: 'center'
        }
      );
      ctx.globalAlpha = pulse;
      this.drawText(
        'PRESS [P / SPACE / Z] TO RESUME  |  [BACKSPACE] ARCADE LOBBY',
        this.width / 2,
        by + 216,
        {
          font: FONTS.HEADER,
          size: 10.5,
          color: PALETTE.CYAN,
          align: 'center'
        }
      );
      ctx.globalAlpha = 1;
      this.drawText('CREDIT 01  •  CRT SCANLINE EMULATION ACTIVE', this.width / 2, by + 268, {
        font: FONTS.HEADER,
        size: 8,
        color: PALETTE.MUTED,
        align: 'center'
      });
    } else if (state === 'GAMEOVER') {
      this.drawText('GAME OVER', this.width / 2, by + 54, {
        font: FONTS.HEADER,
        size: 24,
        color: PALETTE.PINK,
        align: 'center',
        glow: 14
      });
      this.drawText(
        `1UP SCORE: ${String(Math.floor(score)).padStart(6, '0')}    HIGH: ${String(
          Math.floor(Math.max(score, highScore))
        ).padStart(6, '0')}`,
        this.width / 2,
        by + 96,
        {
          font: FONTS.HEADER,
          size: 11.5,
          color: PALETTE.WHITE,
          align: 'center'
        }
      );

      // 3-Initial Arcade Champion Selector
      const chars = this.initialsChars || ['A', 'C', 'E'];
      this.drawText(
        `ENTER INITIALS (UP/DOWN CHAR, L/R SLOT):  [ ${chars[0]} ] [ ${chars[1]} ] [ ${chars[2]} ]`,
        this.width / 2,
        by + 140,
        {
          font: FONTS.HEADER,
          size: 10,
          color: PALETTE.GOLD,
          align: 'center',
          glow: 8
        }
      );

      this.drawText(
        'PRESS [F8] TO LOAD SAVED STATE OR HOLD [R] TO REWIND!',
        this.width / 2,
        by + 180,
        {
          font: FONTS.HEADER,
          size: 8.5,
          color: PALETTE.CYAN,
          align: 'center'
        }
      );

      ctx.globalAlpha = pulse;
      this.drawText(
        blinkCoin
          ? 'INSERT COIN  •  PRESS [SPACE / Z / TAP] TO CONTINUE'
          : 'PRESS [SPACE / Z / TAP] TO PLAY AGAIN',
        this.width / 2,
        by + 226,
        {
          font: FONTS.HEADER,
          size: 11.5,
          color: PALETTE.GREEN,
          align: 'center',
          glow: 8
        }
      );
      ctx.globalAlpha = 1;
      this.drawText('OR CLICK [STUDIO LOBBY] TO SWITCH CABINETS', this.width / 2, by + 266, {
        font: FONTS.HEADER,
        size: 8.5,
        color: PALETTE.MUTED,
        align: 'center'
      });
    }

    ctx.restore();
  }

  pushToast(opts = {}) {
    if (!opts) return;
    achievementManager.pushToast(
      `${opts.icon ? opts.icon + ' ' : ''}${opts.title || 'ARCADE NOTICE'}`,
      opts.desc || opts.subtitle || '',
      opts.color || PALETTE.CYAN
    );
  }

  triggerShutterFlash() {
    this.shutterFlashTimer = 0.25;
    this.flashAlpha = 0.85;
  }

  destroy() {
    if (typeof window !== 'undefined' && this._onResize) {
      window.removeEventListener('resize', this._onResize);
      window.removeEventListener('orientationchange', this._onResize);
    }
  }
}


// === src/games/BattleCity.js ===
/**
 * BattleCity.js
 * Classic 1985 Namco Top-Down Tank Warfare & Base Defense ("Tank Battalion").
 * Features a 26x16 destructible tile battlefield protecting the Phoenix Base Emblem,
 * 5 terrain types (Red Brick, White Steel, Camouflage Trees, Blue Water, Slippery Ice),
 * 4 enemy tank classes (Light, Fast, Sniper, 3-Hit Heavy Armor), and 5 flashing power-ups
 * (Star Upgrade, Grenade Wipe, Shovel Steel Base Fortification, Clock Freeze, Helmet Shield).
 */

const TILE = {
  EMPTY: 0,
  BRICK: 1,
  STEEL: 2,
  TREES: 3,
  WATER: 4,
  ICE: 5,
  BASE: 6,
  BASE_DEAD: 7
};

const DIRS = {
  up: { x: 0, y: -1, angle: 0 },
  right: { x: 1, y: 0, angle: Math.PI * 0.5 },
  down: { x: 0, y: 1, angle: Math.PI },
  left: { x: -1, y: 0, angle: -Math.PI * 0.5 }
};

const ENEMY_TYPES = {
  LIGHT: { name: 'LIGHT', hp: 1, speed: 86, bulletSpeed: 260, pts: 100, color: '#CBD5E1' },
  FAST: { name: 'FAST', hp: 1, speed: 138, bulletSpeed: 290, pts: 200, color: '#38BDF8' },
  SNIPER: { name: 'SNIPER', hp: 1, speed: 95, bulletSpeed: 410, pts: 300, color: '#F59E0B' },
  HEAVY: { name: 'HEAVY', hp: 3, speed: 68, bulletSpeed: 270, pts: 400, color: '#10B981' }
};

const POWERUP_TYPES = ['STAR', 'GRENADE', 'SHOVEL', 'CLOCK', 'HELMET'];
class BattleCity {
  constructor(renderer, input, audio) {
    this.renderer = renderer;
    this.input = input;
    this.audio = audio;

    this.id = 'battlecity';
    this.title = 'Battle City';

    this.state = 'PLAYING';
    this.score = 0;
    this.highScore = HighScoreStore.get(this.id);
    this.lives = 3;
    this.level = 1;

    // 26x16 Tile Grid (28x28px tiles = 728x448 battlefield)
    this.cols = 26;
    this.rows = 16;
    this.tileSize = 28;
    this.arenaX = 36;
    this.arenaY = 58;

    this.grid = [];
    this.brickHp = [];
    this.player = null;
    this.enemies = [];
    this.bullets = [];
    this.powerUp = null;
    this.particles = [];
    this.popups = [];

    this.enemiesRemainingToSpawn = 16;
    this.spawnTimer = 0;
    this.spawnIndex = 0;
    this.freezeTimer = 0;
    this.shovelTimer = 0;
    this.baseDestroyed = false;
    this.stageClearTimer = 0;
    this.deathTimer = 0;
    this.animTime = 0;

    this.reset();
  }

  reset() {
    this.score = 0;
    this.lives = 3;
    this.level = 1;
    this.highScore = HighScoreStore.get(this.id);
    this.state = 'PLAYING';
    this.initStage(this.level, true);
  }

  setState(state) {
    this.state = state;
  }

  destroy() {
    if (this.audio && typeof this.audio.stopSequence === 'function') {
      this.audio.stopSequence();
    }
  }

  addScore(pts, x = null, y = null, color = PALETTE.GOLD, label = null) {
    this.score += pts;
    if (this.score > this.highScore) {
      this.highScore = this.score;
      HighScoreStore.submit(this.id, this.score);
    }
    if (x !== null && y !== null) {
      this.popups.push({
        text: label ? `${label} +${pts}` : `+${pts}`,
        x,
        y,
        vy: -36,
        life: 1.0,
        maxLife: 1.0,
        color
      });
    }
  }

  initStage(level, fullReset = false) {
    this.bullets = [];
    this.enemies = [];
    this.particles = [];
    this.popups = [];
    this.powerUp = null;
    this.freezeTimer = 0;
    this.shovelTimer = 0;
    this.baseDestroyed = false;
    this.stageClearTimer = 0;
    this.deathTimer = 0;
    this.enemiesRemainingToSpawn = 14 + Math.min(10, level * 2);
    this.spawnTimer = 0.6;
    this.spawnIndex = 0;

    this.buildMap(level);
    const keepStar = !fullReset && this.player ? this.player.starLevel : 0;
    this.spawnPlayer(keepStar);
  }

  buildMap(level) {
    this.grid = [];
    this.brickHp = [];
    for (let r = 0; r < this.rows; r++) {
      this.grid.push(new Uint8Array(this.cols).fill(TILE.EMPTY));
      this.brickHp.push(new Uint8Array(this.cols).fill(0));
    }

    const setTile = (c, r, t) => {
      if (c >= 0 && c < this.cols && r >= 0 && r < this.rows) {
        this.grid[r][c] = t;
        this.brickHp[r][c] = t === TILE.BRICK ? 2 : 0;
      }
    };

    const STAGE_NAMES = [
      'CLASSIC COLUMNS',
      'STEEL CORRIDORS',
      'TWIN RIVER BRIDGES',
      'FOREST AMBUSH',
      'GLACIER ICE RING',
      'CROSSROAD MOAT',
      'CITADEL OF STEEL',
      'TWIN FORTRESSES',
      'ZIG-ZAG CANYON',
      'IRON CURTAIN FINALE'
    ];
    const layoutIdx = (level - 1) % 10;
    this.stageName = STAGE_NAMES[layoutIdx];

    const fillRect = (c1, r1, c2, r2, t) => {
      for (let r = r1; r <= r2; r++) {
        for (let c = c1; c <= c2; c++) {
          setTile(c, r, t);
        }
      }
    };

    if (layoutIdx === 0) {
      // Stage 1: Classic 1985 Stage 1 (6 vertical brick columns + center brick H-bar)
      for (let r = 2; r <= 12; r++) {
        if (r === 7) continue;
        for (const c of [2, 3, 6, 7, 10, 11, 14, 15, 18, 19, 22, 23]) {
          setTile(c, r, TILE.BRICK);
        }
      }
      fillRect(10, 5, 15, 6, TILE.BRICK);
      setTile(12, 4, TILE.STEEL);
      setTile(13, 4, TILE.STEEL);
      fillRect(0, 6, 1, 8, TILE.BRICK);
      fillRect(24, 6, 25, 8, TILE.BRICK);
    } else if (layoutIdx === 1) {
      // Stage 2: Steel & Brick Corridors with asymmetric steel shields
      for (let r = 2; r <= 12; r++) {
        if (r === 6 || r === 7) continue;
        for (const c of [2, 3, 6, 7, 10, 11, 14, 15, 18, 19, 22, 23]) {
          setTile(c, r, TILE.BRICK);
        }
      }
      fillRect(6, 3, 7, 4, TILE.STEEL);
      fillRect(14, 2, 15, 3, TILE.STEEL);
      fillRect(22, 4, 23, 5, TILE.STEEL);
      fillRect(0, 6, 3, 7, TILE.TREES);
      fillRect(18, 6, 21, 8, TILE.TREES);
      fillRect(10, 8, 15, 8, TILE.STEEL);
    } else if (layoutIdx === 2) {
      // Stage 3: Twin River Bridges with Forest Camouflage belt
      for (let c = 0; c < this.cols; c++) {
        if ((c >= 5 && c <= 7) || (c >= 18 && c <= 20)) {
          setTile(c, 7, TILE.BRICK);
          setTile(c, 8, TILE.ICE);
        } else {
          setTile(c, 7, TILE.WATER);
          setTile(c, 8, TILE.WATER);
        }
      }
      fillRect(2, 5, 23, 6, TILE.TREES);
      fillRect(3, 2, 4, 4, TILE.BRICK);
      fillRect(11, 2, 14, 4, TILE.BRICK);
      fillRect(21, 2, 22, 4, TILE.BRICK);
      fillRect(4, 10, 9, 11, TILE.BRICK);
      fillRect(16, 10, 21, 11, TILE.BRICK);
      setTile(12, 10, TILE.STEEL);
      setTile(13, 10, TILE.STEEL);
    } else if (layoutIdx === 3) {
      // Stage 4: Forest Ambush (dense green canopy hiding sniper lanes)
      fillRect(2, 3, 23, 11, TILE.TREES);
      for (const c of [5, 6, 12, 13, 19, 20]) {
        fillRect(c, 2, c, 12, TILE.BRICK);
      }
      fillRect(2, 6, 23, 7, TILE.TREES);
      fillRect(8, 4, 9, 5, TILE.STEEL);
      fillRect(16, 4, 17, 5, TILE.STEEL);
      fillRect(0, 7, 1, 9, TILE.WATER);
      fillRect(24, 7, 25, 9, TILE.WATER);
    } else if (layoutIdx === 4) {
      // Stage 5: Glacier Ice Ring (slippery ice tracks around central steel bunker)
      fillRect(3, 3, 22, 4, TILE.ICE);
      fillRect(3, 10, 22, 11, TILE.ICE);
      fillRect(3, 4, 4, 10, TILE.ICE);
      fillRect(21, 4, 22, 10, TILE.ICE);
      fillRect(9, 6, 16, 8, TILE.STEEL);
      fillRect(11, 6, 14, 8, TILE.BRICK);
      fillRect(6, 6, 7, 8, TILE.BRICK);
      fillRect(18, 6, 19, 8, TILE.BRICK);
      fillRect(0, 5, 1, 9, TILE.TREES);
      fillRect(24, 5, 25, 9, TILE.TREES);
    } else if (layoutIdx === 5) {
      // Stage 6: The Crossroad Moat (horizontal & vertical water channels with brick bridges)
      for (let c = 0; c < this.cols; c++) {
        if (c !== 4 && c !== 5 && c !== 12 && c !== 13 && c !== 20 && c !== 21) {
          setTile(c, 7, TILE.WATER);
        }
      }
      for (let r = 2; r <= 12; r++) {
        if (r !== 4 && r !== 7 && r !== 10) {
          setTile(8, r, TILE.WATER);
          setTile(17, r, TILE.WATER);
        }
      }
      fillRect(2, 2, 6, 5, TILE.BRICK);
      fillRect(19, 2, 23, 5, TILE.BRICK);
      fillRect(10, 3, 15, 5, TILE.BRICK);
      fillRect(10, 9, 15, 11, TILE.BRICK);
      fillRect(2, 9, 6, 11, TILE.TREES);
      fillRect(19, 9, 23, 11, TILE.TREES);
      setTile(12, 6, TILE.STEEL);
      setTile(13, 6, TILE.STEEL);
    } else if (layoutIdx === 6) {
      // Stage 7: Citadel of Steel (checkerboard steel blocks & brick pockets)
      for (let r = 2; r <= 11; r += 3) {
        for (let c = 2; c <= 22; c += 4) {
          fillRect(c, r, c + 1, r + 1, (r + c) % 2 === 0 ? TILE.STEEL : TILE.BRICK);
        }
      }
      fillRect(8, 6, 17, 7, TILE.BRICK);
      fillRect(11, 3, 14, 4, TILE.STEEL);
      fillRect(0, 4, 1, 10, TILE.ICE);
      fillRect(24, 4, 25, 10, TILE.ICE);
    } else if (layoutIdx === 7) {
      // Stage 8: Twin Fortresses (two upper enemy bastions overlooking the Phoenix base)
      fillRect(2, 2, 9, 6, TILE.BRICK);
      fillRect(4, 3, 7, 5, TILE.EMPTY);
      fillRect(4, 6, 7, 6, TILE.STEEL);

      fillRect(16, 2, 23, 6, TILE.BRICK);
      fillRect(18, 3, 21, 5, TILE.EMPTY);
      fillRect(18, 6, 21, 6, TILE.STEEL);

      fillRect(11, 3, 14, 7, TILE.TREES);
      fillRect(3, 9, 8, 11, TILE.BRICK);
      fillRect(17, 9, 22, 11, TILE.BRICK);
      fillRect(10, 10, 15, 10, TILE.WATER);
    } else if (layoutIdx === 8) {
      // Stage 9: Zig-Zag Canyon (diagonal brick walls & ice chutes)
      for (let i = 0; i < 10; i++) {
        fillRect(2 + i, 2 + i, 3 + i, 3 + i, TILE.BRICK);
        fillRect(22 - i, 2 + i, 23 - i, 3 + i, TILE.BRICK);
      }
      fillRect(11, 2, 14, 5, TILE.ICE);
      fillRect(2, 7, 6, 9, TILE.ICE);
      fillRect(19, 7, 23, 9, TILE.ICE);
      fillRect(11, 6, 14, 7, TILE.STEEL);
      fillRect(8, 10, 17, 11, TILE.TREES);
    } else {
      // Stage 10: Iron Curtain Finale (fortified steel & water perimeter)
      fillRect(2, 3, 23, 3, TILE.STEEL);
      setTile(6, 3, TILE.BRICK);
      setTile(7, 3, TILE.BRICK);
      setTile(12, 3, TILE.BRICK);
      setTile(13, 3, TILE.BRICK);
      setTile(18, 3, TILE.BRICK);
      setTile(19, 3, TILE.BRICK);

      for (let c = 1; c <= 24; c++) {
        if (c !== 4 && c !== 5 && c !== 12 && c !== 13 && c !== 20 && c !== 21) {
          setTile(c, 8, TILE.WATER);
        } else {
          setTile(c, 8, TILE.ICE);
        }
      }
      fillRect(3, 5, 10, 6, TILE.BRICK);
      fillRect(15, 5, 22, 6, TILE.BRICK);
      fillRect(11, 5, 14, 6, TILE.STEEL);
      fillRect(4, 10, 9, 11, TILE.TREES);
      fillRect(16, 10, 21, 11, TILE.TREES);
      fillRect(10, 11, 15, 11, TILE.STEEL);
      setTile(12, 11, TILE.BRICK);
      setTile(13, 11, TILE.BRICK);
    }

    // Clear top 3 enemy spawn zones & player spawn zone
    for (const sc of [0, 1, 12, 13, 24, 25]) {
      setTile(sc, 0, TILE.EMPTY);
      setTile(sc, 1, TILE.EMPTY);
    }
    for (let c = 8; c <= 17; c++) {
      setTile(c, 14, TILE.EMPTY);
      setTile(c, 15, TILE.EMPTY);
    }

    // Phoenix Base Emblem at bottom center (cols 12..13, row 15) + Brick Wall perimeter
    this.fortifyBase(TILE.BRICK);
    setTile(12, 15, TILE.BASE);
    setTile(13, 15, TILE.BASE);
  }

  fortifyBase(wallType = TILE.BRICK) {
    const coords = [
      [11, 14], [12, 14], [13, 14], [14, 14],
      [11, 15], [14, 15]
    ];
    for (const [c, r] of coords) {
      this.grid[r][c] = wallType;
      this.brickHp[r][c] = wallType === TILE.BRICK ? 2 : 0;
    }
  }

  spawnPlayer(starLevel = 0) {
    // Spawn just left of the Phoenix Base
    this.player = {
      x: this.arenaX + 9.5 * this.tileSize,
      y: this.arenaY + 15 * this.tileSize,
      vx: 0,
      vy: 0,
      dir: 'up',
      radius: 11,
      speed: 112,
      starLevel,
      shieldTimer: 3.5, // Spawn helmet shield
      fireCooldown: 0,
      treadTick: 0
    };
  }

  spawnEnemy() {
    if (this.enemiesRemainingToSpawn <= 0 || this.enemies.length >= 5) return;
    const spawnCols = [1, 12.5, 24];
    const sc = spawnCols[this.spawnIndex % spawnCols.length];
    this.spawnIndex++;
    const sx = this.arenaX + sc * this.tileSize;
    const sy = this.arenaY + 0.8 * this.tileSize;

    // Roll enemy archetype
    const roll = (this.spawnIndex + this.level) % 6;
    let typeKey = 'LIGHT';
    if (roll === 1 || roll === 4) typeKey = 'FAST';
    else if (roll === 2) typeKey = 'SNIPER';
    else if (roll === 5) typeKey = 'HEAVY';

    const def = ENEMY_TYPES[typeKey];
    const isBonus = this.spawnIndex % 4 === 0;

    this.enemiesRemainingToSpawn--;
    this.enemies.push({
      typeKey,
      name: def.name,
      hp: def.hp,
      maxHp: def.hp,
      pts: def.pts,
      color: def.color,
      isBonus,
      x: sx,
      y: sy,
      dir: 'down',
      radius: 11,
      speed: def.speed,
      bulletSpeed: def.bulletSpeed,
      fireCooldown: 0.9 + Math.random() * 0.8,
      turnTimer: 1.2 + Math.random() * 1.4,
      treadTick: 0
    });
  }

  worldToTile(x, y) {
    return {
      c: Math.floor((x - this.arenaX) / this.tileSize),
      r: Math.floor((y - this.arenaY) / this.tileSize)
    };
  }

  isTileSolidForTank(c, r) {
    if (c < 0 || c >= this.cols || r < 0 || r >= this.rows) return true;
    const t = this.grid[r][c];
    return t === TILE.BRICK || t === TILE.STEEL || t === TILE.WATER || t === TILE.BASE || t === TILE.BASE_DEAD;
  }

  canTankOccupy(x, y, radius = 11) {
    const corners = [
      { x: x - radius, y: y - radius },
      { x: x + radius, y: y - radius },
      { x: x - radius, y: y + radius },
      { x: x + radius, y: y + radius }
    ];
    for (const pt of corners) {
      const { c, r } = this.worldToTile(pt.x, pt.y);
      if (this.isTileSolidForTank(c, r)) return false;
    }
    return true;
  }

  isTankOnIce(x, y) {
    const { c, r } = this.worldToTile(x, y);
    if (c < 0 || c >= this.cols || r < 0 || r >= this.rows) return false;
    return this.grid[r][c] === TILE.ICE;
  }

  fireBullet(tank, isPlayer) {
    const vec = DIRS[tank.dir];
    const bSpeed = isPlayer ? 310 + tank.starLevel * 55 : tank.bulletSpeed;
    const canBreakSteel = isPlayer && tank.starLevel >= 3;

    this.bullets.push({
      x: tank.x + vec.x * 14,
      y: tank.y + vec.y * 14,
      vx: vec.x * bSpeed,
      vy: vec.y * bSpeed,
      isPlayer,
      canBreakSteel
    });

    if (isPlayer) {
      this.audio.playLaser(560, 180, 0.08);
    }
  }

  spawnRandomPowerUp() {
    const type = POWERUP_TYPES[Math.floor(Math.random() * POWERUP_TYPES.length)];
    const c = 2 + Math.floor(Math.random() * (this.cols - 4));
    const r = 2 + Math.floor(Math.random() * (this.rows - 5));
    this.powerUp = {
      type,
      x: this.arenaX + (c + 0.5) * this.tileSize,
      y: this.arenaY + (r + 0.5) * this.tileSize,
      timer: 14.0
    };
    this.audio.playCoin();
  }

  collectPowerUp(pu) {
    this.audio.playPowerUp();
    this.addScore(500, pu.x, pu.y - 12, PALETTE.GOLD, pu.type);

    if (pu.type === 'STAR') {
      this.player.starLevel = Math.min(3, this.player.starLevel + 1);
    } else if (pu.type === 'HELMET') {
      this.player.shieldTimer = 12.0;
    } else if (pu.type === 'CLOCK') {
      this.freezeTimer = 10.0;
    } else if (pu.type === 'SHOVEL') {
      this.shovelTimer = 16.0;
      this.fortifyBase(TILE.STEEL);
    } else if (pu.type === 'GRENADE') {
      // Wipe all active enemy tanks on screen!
      for (const e of this.enemies) {
        this.spawnExplosion(e.x, e.y, PALETTE.ORANGE, 22);
        this.addScore(e.pts, e.x, e.y, PALETTE.GOLD);
      }
      this.enemies = [];
      this.audio.playExplosion(0.45, 800);
      this.renderer.shake(10, 0.3);
      this.checkVictory();
    }
    this.powerUp = null;
  }

  spawnExplosion(x, y, color = PALETTE.ORANGE, count = 20) {
    for (let i = 0; i < count; i++) {
      const a = (Math.PI * 2 * i) / count + Math.random() * 0.2;
      const spd = 45 + Math.random() * 140;
      this.particles.push({
        x,
        y,
        vx: Math.cos(a) * spd,
        vy: Math.sin(a) * spd,
        size: 3.5 + Math.random() * 2.5,
        life: 0.4 + Math.random() * 0.25,
        color: i % 2 === 0 ? color : PALETTE.GOLD
      });
    }
  }

  destroyBase() {
    if (this.baseDestroyed) return;
    this.baseDestroyed = true;
    this.grid[15][12] = TILE.BASE_DEAD;
    this.grid[15][13] = TILE.BASE_DEAD;
    const bx = this.arenaX + 13 * this.tileSize;
    const by = this.arenaY + 15.5 * this.tileSize;
    this.spawnExplosion(bx, by, PALETTE.RED, 38);
    this.audio.playExplosion(0.55, 650);
    this.renderer.shake(12, 0.4);
    this.popups.push({
      text: 'PHOENIX BASE DESTROYED!',
      x: bx,
      y: by - 30,
      vy: -25,
      life: 1.5,
      maxLife: 1.5,
      color: PALETTE.RED
    });
    HighScoreStore.submit(this.id, this.score);
    this.audio.playGameOver();
    this.state = 'GAMEOVER';
  }

  killPlayer() {
    if (this.deathTimer > 0 || this.stageClearTimer > 0) return;
    this.lives--;
    this.audio.playExplosion(0.4, 800);
    this.renderer.shake(9, 0.3);
    this.spawnExplosion(this.player.x, this.player.y, PALETTE.GOLD, 26);

    if (this.lives <= 0) {
      HighScoreStore.submit(this.id, this.score);
      this.audio.playGameOver();
      this.state = 'GAMEOVER';
    } else {
      this.deathTimer = 1.2;
    }
  }

  checkVictory() {
    if (this.enemiesRemainingToSpawn <= 0 && this.enemies.length === 0 && this.stageClearTimer <= 0) {
      this.addScore(1500, 400, 260, PALETTE.GREEN, 'BATTALION CLEARED');
      this.audio.playStageClear();
      this.stageClearTimer = 1.6;
    }
  }

  update(dt) {
    this.animTime += dt;

    if (this.input.isJustPressed('pause')) {
      this.state = this.state === 'PLAYING' ? 'PAUSED' : 'PLAYING';
      return;
    }

    if (this.state === 'MENU' || this.state === 'GAMEOVER') {
      if (this.input.isJustPressed('actionA') || this.input.pointer.justPressed) {
        this.audio.playMenuSelect();
        this.reset();
      }
      return;
    }

    if (this.state === 'PAUSED') {
      if (this.input.isJustPressed('actionA')) this.state = 'PLAYING';
      return;
    }

    this.updateEffects(dt);

    if (this.stageClearTimer > 0) {
      this.stageClearTimer -= dt;
      if (this.stageClearTimer <= 0) {
        this.level++;
        this.initStage(this.level, false);
      }
      return;
    }

    if (this.deathTimer > 0) {
      this.deathTimer -= dt;
      if (this.deathTimer <= 0) {
        this.spawnPlayer(0);
      }
      return;
    }

    // Power-up timers
    if (this.freezeTimer > 0) this.freezeTimer = Math.max(0, this.freezeTimer - dt);
    if (this.shovelTimer > 0) {
      this.shovelTimer -= dt;
      if (this.shovelTimer <= 0) {
        this.fortifyBase(TILE.BRICK);
      }
    }
    if (this.powerUp) {
      this.powerUp.timer -= dt;
      if (this.powerUp.timer <= 0) this.powerUp = null;
    }

    // Spawn enemy tanks periodically
    this.spawnTimer -= dt;
    if (this.spawnTimer <= 0) {
      this.spawnTimer = Math.max(1.4, 2.8 - this.level * 0.15);
      this.spawnEnemy();
    }

    this.updatePlayer(dt);
    this.updateEnemies(dt);
    this.updateBullets(dt);
  }

  updatePlayer(dt) {
    const p = this.player;
    if (p.shieldTimer > 0) p.shieldTimer = Math.max(0, p.shieldTimer - dt);
    if (p.fireCooldown > 0) p.fireCooldown = Math.max(0, p.fireCooldown - dt);

    let moveDir = null;
    if (this.input.isDown('up')) moveDir = 'up';
    else if (this.input.isDown('down')) moveDir = 'down';
    else if (this.input.isDown('left')) moveDir = 'left';
    else if (this.input.isDown('right')) moveDir = 'right';

    const onIce = this.isTankOnIce(p.x, p.y);
    const spd = p.speed + p.starLevel * 12;

    if (moveDir) {
      p.dir = moveDir;
      const vec = DIRS[moveDir];
      p.vx = vec.x * spd;
      p.vy = vec.y * spd;
      p.treadTick += dt * 16;
    } else if (onIce) {
      // Slide on ice!
      p.vx *= Math.pow(0.18, dt);
      p.vy *= Math.pow(0.18, dt);
    } else {
      p.vx = 0;
      p.vy = 0;
    }

    if (Math.hypot(p.vx, p.vy) > 2) {
      const nx = p.x + p.vx * dt;
      const ny = p.y + p.vy * dt;
      if (this.canTankOccupy(nx, p.y, p.radius)) p.x = nx;
      if (this.canTankOccupy(p.x, ny, p.radius)) p.y = ny;
    }

    // Fire Cannon
    const activePlayerBullets = this.bullets.filter((b) => b.isPlayer).length;
    const maxBullets = p.starLevel >= 2 ? 2 : 1;
    if (
      (this.input.isJustPressed('actionA') ||
        this.input.isJustPressed('actionB') ||
        this.input.pointer.justPressed) &&
      p.fireCooldown <= 0 &&
      activePlayerBullets < maxBullets
    ) {
      p.fireCooldown = p.starLevel >= 1 ? 0.18 : 0.28;
      this.fireBullet(p, true);
    }

    // Check Power-Up collection
    if (this.powerUp && Math.hypot(p.x - this.powerUp.x, p.y - this.powerUp.y) < 22) {
      this.collectPowerUp(this.powerUp);
    }
  }

  updateEnemies(dt) {
    if (this.freezeTimer > 0) return;

    const baseCenterX = this.arenaX + 13 * this.tileSize;
    const baseCenterY = this.arenaY + 15.5 * this.tileSize;

    for (const e of this.enemies) {
      e.treadTick += dt * 14;
      e.turnTimer -= dt;
      e.fireCooldown -= dt;

      const vec = DIRS[e.dir];
      const nx = e.x + vec.x * e.speed * dt;
      const ny = e.y + vec.y * e.speed * dt;

      if (this.canTankOccupy(nx, ny, e.radius) && e.turnTimer > 0) {
        e.x = nx;
        e.y = ny;
      } else {
        // Choose a new direction biased toward the Phoenix Base or Player
        const dirs = ['down', 'left', 'right', 'up'];
        if (Math.random() < 0.48) {
          if (Math.abs(baseCenterX - e.x) > Math.abs(baseCenterY - e.y)) {
            e.dir = baseCenterX > e.x ? 'right' : 'left';
          } else {
            e.dir = 'down';
          }
        } else {
          e.dir = dirs[Math.floor(Math.random() * dirs.length)];
        }
        e.turnTimer = 0.9 + Math.random() * 1.4;
      }

      if (e.fireCooldown <= 0) {
        e.fireCooldown = 1.1 + Math.random() * 1.1;
        this.fireBullet(e, false);
      }
    }
  }

  updateBullets(dt) {
    for (let i = this.bullets.length - 1; i >= 0; i--) {
      const b = this.bullets[i];
      b.x += b.vx * dt;
      b.y += b.vy * dt;

      // Arena bounds check
      if (
        b.x < this.arenaX ||
        b.x > this.arenaX + this.cols * this.tileSize ||
        b.y < this.arenaY ||
        b.y > this.arenaY + this.rows * this.tileSize
      ) {
        this.bullets.splice(i, 1);
        continue;
      }

      // Tile collision check
      const { c, r } = this.worldToTile(b.x, b.y);
      if (c >= 0 && c < this.cols && r >= 0 && r < this.rows) {
        const t = this.grid[r][c];
        if (t === TILE.BRICK) {
          this.brickHp[r][c]--;
          if (this.brickHp[r][c] <= 0 || b.canBreakSteel) {
            this.grid[r][c] = TILE.EMPTY;
          }
          this.spawnExplosion(b.x, b.y, '#EA580C', 8);
          this.audio.playDig();
          this.bullets.splice(i, 1);
          continue;
        } else if (t === TILE.STEEL) {
          if (b.canBreakSteel) {
            this.grid[r][c] = TILE.EMPTY;
            this.spawnExplosion(b.x, b.y, PALETTE.WHITE, 12);
          } else {
            this.spawnExplosion(b.x, b.y, PALETTE.CYAN, 5);
          }
          this.audio.playHit();
          this.bullets.splice(i, 1);
          continue;
        } else if (t === TILE.BASE) {
          this.bullets.splice(i, 1);
          this.destroyBase();
          return;
        }
      }

      // Bullet-vs-Bullet cancellation
      let cancelled = false;
      for (let j = i - 1; j >= 0; j--) {
        const other = this.bullets[j];
        if (b.isPlayer !== other.isPlayer && Math.hypot(b.x - other.x, b.y - other.y) < 10) {
          this.spawnExplosion(b.x, b.y, PALETTE.WHITE, 6);
          this.bullets.splice(i, 1);
          this.bullets.splice(j, 1);
          i--;
          cancelled = true;
          break;
        }
      }
      if (cancelled) continue;

      // Player bullet hitting Enemy Tanks
      if (b.isPlayer) {
        let hitEnemy = false;
        for (let k = this.enemies.length - 1; k >= 0; k--) {
          const e = this.enemies[k];
          if (Math.hypot(b.x - e.x, b.y - e.y) < e.radius + 4) {
            hitEnemy = true;
            if (e.isBonus) {
              e.isBonus = false;
              this.spawnRandomPowerUp();
            }
            e.hp--;
            if (e.hp <= 0) {
              this.spawnExplosion(e.x, e.y, PALETTE.ORANGE, 22);
              this.audio.playExplosion(0.32, 950);
              this.addScore(e.pts, e.x, e.y, PALETTE.GOLD, e.name);
              this.enemies.splice(k, 1);
              this.checkVictory();
            } else {
              this.audio.playHit();
              this.spawnExplosion(b.x, b.y, PALETTE.GREEN, 6);
            }
            break;
          }
        }
        if (hitEnemy) {
          this.bullets.splice(i, 1);
          continue;
        }
      } else {
        // Enemy bullet hitting Player Tank
        const p = this.player;
        if (this.deathTimer <= 0 && Math.hypot(b.x - p.x, b.y - p.y) < p.radius + 4) {
          this.bullets.splice(i, 1);
          if (p.shieldTimer <= 0) {
            this.killPlayer();
            return;
          } else {
            this.spawnExplosion(b.x, b.y, PALETTE.CYAN, 8);
          }
        }
      }
    }
  }

  updateEffects(dt) {
    for (let i = this.particles.length - 1; i >= 0; i--) {
      const pt = this.particles[i];
      pt.x += pt.vx * dt;
      pt.y += pt.vy * dt;
      pt.life -= dt;
      if (pt.life <= 0) this.particles.splice(i, 1);
    }
    for (let i = this.popups.length - 1; i >= 0; i--) {
      const pop = this.popups[i];
      pop.y += pop.vy * dt;
      pop.life -= dt;
      if (pop.life <= 0) this.popups.splice(i, 1);
    }
  }

  render(ctx = this.renderer.ctx) {
    this.renderer.clear('#1E293B');

    // Black Battlefield Interior
    ctx.fillStyle = '#070A12';
    ctx.fillRect(
      this.arenaX,
      this.arenaY,
      this.cols * this.tileSize,
      this.rows * this.tileSize
    );
    ctx.strokeStyle = '#64748B';
    ctx.lineWidth = 2;
    ctx.strokeRect(
      this.arenaX - 2,
      this.arenaY - 2,
      this.cols * this.tileSize + 4,
      this.rows * this.tileSize + 4
    );

    this.drawGroundTiles(ctx);
    this.drawPowerUp(ctx);
    if (this.deathTimer <= 0) {
      this.drawTank(ctx, this.player, true);
    }
    for (const e of this.enemies) {
      this.drawTank(ctx, e, false);
    }
    this.drawBullets(ctx);
    this.drawForestLayer(ctx);
    this.drawSideStatusPanel(ctx);
    this.drawEffects(ctx);

    this.renderer.drawHUD({
      title: this.title,
      score: this.score,
      highScore: this.highScore,
      lives: this.lives,
      level: this.level,
      extraLabel: `STAR:★${this.player ? this.player.starLevel : 0}  ENEMIES:${this.enemiesRemainingToSpawn + this.enemies.length}`,
      accent: PALETTE.GOLD
    });

    this.renderer.drawStateOverlay(this.state, {
      title: this.title,
      subtitle: '1985 NAMCO TANK BATTALION BASE DEFENSE',
      controls: 'ARROWS/WASD: DRIVE TANK  |  Z/X/SPACE: FIRE CANNON',
      score: this.score,
      highScore: this.highScore,
      accent: PALETTE.GOLD
    });
  }

  drawGroundTiles(ctx) {
    ctx.save();
    const ts = this.tileSize;
    const waterPulse = Math.floor(this.animTime * 4) % 2 === 0;

    for (let r = 0; r < this.rows; r++) {
      for (let c = 0; c < this.cols; c++) {
        const t = this.grid[r][c];
        const x = this.arenaX + c * ts;
        const y = this.arenaY + r * ts;

        if (t === TILE.BRICK) {
          ctx.fillStyle = this.brickHp[r][c] === 1 ? '#9A3412' : '#C2410C';
          ctx.fillRect(x + 1, y + 1, ts - 2, ts - 2);
          ctx.fillStyle = '#FDBA74';
          ctx.fillRect(x + 3, y + 4, ts - 6, 3);
          ctx.fillRect(x + 3, y + 16, ts - 6, 3);
        } else if (t === TILE.STEEL) {
          ctx.fillStyle = '#94A3B8';
          ctx.fillRect(x + 1, y + 1, ts - 2, ts - 2);
          ctx.fillStyle = '#F8FAFC';
          ctx.fillRect(x + 5, y + 5, ts - 10, ts - 10);
        } else if (t === TILE.WATER) {
          ctx.fillStyle = waterPulse ? '#0284C7' : '#0369A1';
          ctx.fillRect(x, y, ts, ts);
          ctx.fillStyle = '#7DD3FC';
          ctx.fillRect(x + (waterPulse ? 4 : 10), y + 8, 10, 3);
          ctx.fillRect(x + (waterPulse ? 12 : 5), y + 19, 10, 3);
        } else if (t === TILE.ICE) {
          ctx.fillStyle = 'rgba(186, 230, 253, 0.32)';
          ctx.fillRect(x, y, ts, ts);
          ctx.strokeStyle = '#E0F2FE';
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(x + 4, y + ts - 4);
          ctx.lineTo(x + ts - 4, y + 4);
          ctx.stroke();
        }
      }
    }

    // Draw Phoenix Base Emblem spanning (12..13, 15)
    const bx = this.arenaX + 12 * ts;
    const by = this.arenaY + 15 * ts;
    if (!this.baseDestroyed) {
      ctx.fillStyle = PALETTE.GOLD;
      ctx.shadowColor = PALETTE.GOLD;
      ctx.shadowBlur = 10;
      // Eagle wings & crest
      ctx.fillRect(bx + 6, by + 6, ts * 2 - 12, 16);
      ctx.fillRect(bx + 18, by + 2, 20, 24);
      ctx.fillStyle = PALETTE.RED;
      ctx.fillRect(bx + 23, by + 9, 10, 10);
    } else {
      ctx.fillStyle = '#475569';
      ctx.fillRect(bx + 8, by + 10, ts * 2 - 16, 14);
    }
    ctx.restore();
  }

  drawForestLayer(ctx) {
    ctx.save();
    const ts = this.tileSize;
    for (let r = 0; r < this.rows; r++) {
      for (let c = 0; c < this.cols; c++) {
        if (this.grid[r][c] === TILE.TREES) {
          const x = this.arenaX + c * ts;
          const y = this.arenaY + r * ts;
          ctx.fillStyle = '#15803D';
          ctx.fillRect(x + 1, y + 1, ts - 2, ts - 2);
          ctx.fillStyle = '#22C55E';
          ctx.fillRect(x + 4, y + 4, 8, 8);
          ctx.fillRect(x + 15, y + 6, 8, 8);
          ctx.fillRect(x + 8, y + 15, 10, 8);
        }
      }
    }
    ctx.restore();
  }

  drawTank(ctx, tank, isPlayer) {
    ctx.save();
    ctx.translate(tank.x, tank.y);
    ctx.rotate(DIRS[tank.dir].angle);

    let bodyColor = PALETTE.GOLD;
    if (!isPlayer) {
      if (tank.isBonus && Math.floor(this.animTime * 10) % 2 === 0) {
        bodyColor = PALETTE.RED;
      } else if (tank.typeKey === 'HEAVY') {
        bodyColor = tank.hp === 3 ? '#10B981' : tank.hp === 2 ? '#FACC15' : '#94A3B8';
      } else {
        bodyColor = tank.color;
      }
    }

    // Left & Right Tank Treads
    ctx.fillStyle = '#334155';
    ctx.fillRect(-11, -11, 5, 22);
    ctx.fillRect(6, -11, 5, 22);
    const treadOffset = Math.floor(tank.treadTick) % 4;
    ctx.fillStyle = '#94A3B8';
    for (let ty = -10 + treadOffset; ty < 10; ty += 5) {
      ctx.fillRect(-11, ty, 5, 2);
      ctx.fillRect(6, ty, 5, 2);
    }

    // Main Chassis & Turret
    ctx.fillStyle = bodyColor;
    ctx.fillRect(-7, -8, 14, 16);
    ctx.fillStyle = '#F8FAFC';
    ctx.fillRect(-4, -4, 8, 8);

    // Cannon Barrel pointing UP in local rotated space
    ctx.fillStyle = bodyColor;
    ctx.fillRect(-2, -15, 4, 11);

    ctx.restore();

    // Helmet Invulnerability Shield ring around Player Tank
    if (isPlayer && tank.shieldTimer > 0) {
      this.renderer.drawGlowCircle(
        tank.x,
        tank.y,
        16,
        Math.floor(this.animTime * 16) % 2 === 0 ? PALETTE.CYAN : PALETTE.WHITE,
        10,
        false,
        2
      );
    }
  }

  drawPowerUp(ctx) {
    if (!this.powerUp) return;
    if (Math.floor(this.animTime * 8) % 2 === 0) return;
    const pu = this.powerUp;
    ctx.save();
    ctx.fillStyle = '#0F172A';
    ctx.strokeStyle = PALETTE.PINK;
    ctx.lineWidth = 2;
    ctx.shadowColor = PALETTE.PINK;
    ctx.shadowBlur = 10;
    ctx.fillRect(pu.x - 14, pu.y - 12, 28, 24);
    ctx.strokeRect(pu.x - 14, pu.y - 12, 28, 24);
    this.renderer.drawText(pu.type.slice(0, 3), pu.x, pu.y + 4, {
      font: FONTS.HEADER,
      size: 7.5,
      color: PALETTE.GOLD,
      align: 'center'
    });
    ctx.restore();
  }

  drawBullets(ctx) {
    ctx.save();
    for (const b of this.bullets) {
      ctx.fillStyle = b.isPlayer ? PALETTE.GOLD : PALETTE.WHITE;
      ctx.shadowColor = ctx.fillStyle;
      ctx.shadowBlur = 6;
      ctx.fillRect(b.x - 3, b.y - 3, 6, 6);
    }
    ctx.restore();
  }

  drawSideStatusPanel(ctx) {
    const px = 784;
    ctx.save();
    ctx.fillStyle = '#0F172A';
    ctx.strokeStyle = PALETTE.GOLD;
    ctx.lineWidth = 2;
    ctx.fillRect(px, 58, 152, 448);
    ctx.strokeRect(px, 58, 152, 448);

    this.renderer.drawText('ENEMY FORCES', px + 76, 84, {
      font: FONTS.HEADER,
      size: 9,
      color: PALETTE.RED,
      align: 'center'
    });

    const totalLeft = this.enemiesRemainingToSpawn + this.enemies.length;
    for (let i = 0; i < totalLeft; i++) {
      const col = i % 2;
      const row = Math.floor(i / 2);
      const ix = px + 44 + col * 46;
      const iy = 104 + row * 22;
      ctx.fillStyle = PALETTE.RED;
      ctx.fillRect(ix, iy, 14, 12);
      ctx.fillStyle = PALETTE.GOLD;
      ctx.fillRect(ix + 5, iy - 4, 4, 6);
    }

    if (this.freezeTimer > 0) {
      this.renderer.drawText(`FREEZE: ${this.freezeTimer.toFixed(1)}S`, px + 76, 420, {
        font: FONTS.HUD,
        size: 13,
        color: PALETTE.CYAN,
        align: 'center'
      });
    }
    if (this.shovelTimer > 0) {
      this.renderer.drawText(`STEEL BASE: ${this.shovelTimer.toFixed(1)}S`, px + 76, 445, {
        font: FONTS.HUD,
        size: 13,
        color: PALETTE.WHITE,
        align: 'center'
      });
    }

    this.renderer.drawText(`STAGE ${this.level}`, px + 76, 482, {
      font: FONTS.HEADER,
      size: 11,
      color: PALETTE.GOLD,
      align: 'center'
    });
    ctx.restore();
  }

  drawEffects(ctx) {
    for (const pt of this.particles) {
      ctx.fillStyle = pt.color;
      ctx.fillRect(pt.x - pt.size * 0.5, pt.y - pt.size * 0.5, pt.size, pt.size);
    }
    for (const pop of this.popups) {
      this.renderer.drawText(pop.text, pop.x, pop.y, {
        font: FONTS.HEADER,
        size: 9.5,
        color: pop.color,
        align: 'center',
        glow: 6
      });
    }
  }
}



// === native frame loop (mirrors src/main.js) ===
// Sprite blitting: identical per-cell rects, issued from C in one call instead of one JS call per cell.
Renderer.prototype.drawPixelSprite = function (rows, x, y, scale = 2, palette = {}, flipX = false, flipY = false) {
  __nc.sprite(rows, x, y, scale, palette, flipX, flipY);
};
const __renderer = new Renderer(null, null);
const __input = new InputManager(null);
const __audio = new AudioSynth();
const __game = new BattleCity(__renderer, __input, __audio);
function __frame() {
  const dt = 1 / 60;
  __input.pollGamepads();
  __input.updateTurbo(dt);
  __renderer.beginFrame(dt);
  __game.update(dt);
  __game.render(__renderer.ctx);
  __renderer.endFrame();
  __input.endFrame();
}
